<UserControl x:Class="DrSoft.MarkCard.UI.Views.GalvoSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d" 
             Foreground="#2A2C2B"
             Background="#F5F5F5"
          d:DesignHeight="420" 
             d:DesignWidth="328">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.ColumnSpan="2" Text="基础设置" Style="{StaticResource HeaderLabel}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="打标卡类型"   Style="{StaticResource LabelText}"/>
                <ComboBox Grid.Row="1" Grid.Column="1"  Style="{StaticResource DrComboxStyle}"    Width="120"       SelectedItem="{Binding MarkCardType}"       ItemsSource="{Binding MarkCardTypes}"   />


                <TextBlock Grid.Row="2" Grid.Column="0" Text="打标卡卡号"  Style="{StaticResource LabelText}"/>

                <ComboBox Grid.Row="2" Grid.Column="1"  Style="{StaticResource DrComboxStyle}"  Width="120" ItemsSource="{Binding CardNos}" SelectedItem="{Binding CardNo}" />





                <TextBlock Grid.Row="3" Grid.Column="0" Text="振镜镜头"  Style="{StaticResource LabelText}"/>
                <ComboBox Grid.Row="3" Grid.Column="1"  Style="{StaticResource DrComboxStyle}" Width="120" ItemsSource="{Binding ScanHeadNos}" SelectedItem="{Binding ScanHeadNo}" />




                <TextBlock Grid.ColumnSpan="2"  Grid.Row="4"  Text="缩放比例(%)" Style="{StaticResource HeaderLabel}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="X"   Style="{StaticResource LabelText}"/>
                <uc:NumericUpDownControl Margin="0,2"  MinValue="0" Grid.Row="5" Grid.Column="1" Title="" Unit=""  Value="{Binding Model.ScaleX}"  Style="{StaticResource MainNumericUpDown}"/>


                <TextBlock Grid.Row="6" Grid.Column="0" Text="Y"   Style="{StaticResource LabelText}"/>
                <uc:NumericUpDownControl Margin="0,2"  MinValue="0" Grid.Row="6" Grid.Column="1" Title="" Unit=""  Value="{Binding Model.ScaleY}"  Style="{StaticResource MainNumericUpDown}"/>


                <TextBlock Grid.ColumnSpan="2"  Grid.Row="7" Text="雕刻时X/Y的偏移(mm)" Style="{StaticResource HeaderLabel}"/>
                <TextBlock Grid.Row="8" Grid.Column="0" Text="X偏移"   Style="{StaticResource LabelText}"/>
                <uc:NumericUpDownControl Margin="0,2"  Grid.Row="8" Grid.Column="1"   Title="" Unit=""  Value="{Binding Model.OffsetX}" Style="{StaticResource MainNumericUpDown}"/>
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Y偏移"   Style="{StaticResource LabelText}"/>
                <uc:NumericUpDownControl Margin="0,2"  Grid.Row="9" Grid.Column="1"    Title="" Unit=""  Value="{Binding Model.OffsetY}" Style="{StaticResource MainNumericUpDown}"/>

                <TextBlock Grid.ColumnSpan="2"  Grid.Row="10" Text="匹配工作台面的旋转角度(°)" Style="{StaticResource HeaderLabel}"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="角度"   Style="{StaticResource LabelText}"/>
                <uc:NumericUpDownControl Margin="0,2"  Grid.Row="11" Grid.Column="1"  Title="" Unit=""  Value="{Binding Model.Rotation}" Style="{StaticResource MainNumericUpDown}"/>




            </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch"/>
        <Button Content="套用当前页面"  HorizontalAlignment="Right" Grid.Row="1"  Style="{StaticResource  ActionButtonStyle}" Width="116"  Command="{Binding ApplyCommand}"/>

    </Grid>

</UserControl>
