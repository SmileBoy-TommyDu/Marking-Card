<UserControl x:Class="DrSoft.MarkCard.UI.Views.LayerOutputIOView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F5F5F5"
             Foreground="#2A2C2B"
             d:DesignHeight="420" d:DesignWidth="328">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="触发时机" VerticalAlignment="Center" Style="{StaticResource MainHeaderLabel}"/>
                    <ComboBox Margin="8,0,0,0" Width="120" Style="{StaticResource DrComboxStyle}"
                              SelectedIndex="{Binding TriggerTimingIndex}">
                        <ComboBoxItem Content="加工前"/>
                        <ComboBoxItem Content="加工后"/>
                    </ComboBox>
                </StackPanel>

                <Border Style="{StaticResource IOBoard}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" Color="#000000" BlurRadius="10" Direction="315" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="输出状态" Style="{StaticResource MainHeaderLabel}"/>
                        <ItemsControl ItemsSource="{Binding OutputList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="4" Columns="4" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="4,6" Style="{StaticResource DrCheckBoxStyle}"
                                              Content="{Binding Index}"
                                              IsChecked="{Binding IsChecked}"
                                              IsEnabled="{Binding IsUsed}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <CheckBox Margin="0,8,0,0" Style="{StaticResource DrCheckBoxStyle}"
                          Content="自动清除信号" IsChecked="{Binding AutoClearSignal}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch"/>
        <Button Grid.Row="1" HorizontalAlignment="Right" Content="套用当前页面"
                Style="{StaticResource ActionButtonStyle}" Width="116" Command="{Binding ApplyCommand}"/>
    </Grid>
</UserControl>
