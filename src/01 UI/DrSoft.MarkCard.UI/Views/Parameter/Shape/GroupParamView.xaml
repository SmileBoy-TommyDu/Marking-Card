             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.Shape" 
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d" 
             Background="#F5F5F5"
             d:DesignHeight="420" d:DesignWidth="328">
    <Grid Margin="8">
        <StackPanel Orientation="Horizontal" Height="32"  VerticalAlignment="Top">
      
            <TextBlock Text="全部有" Margin="0,8,4,0" />
            <uc:NumberDataExpressionTextBox  Value="{Binding InfoText}" Title="" Unit="" IsEnabled="False"  Style="{StaticResource NoTitle}"/>
            <TextBlock Text="个物件" Margin="4,8,0,0"  />
        </StackPanel>
        
    </Grid>
</UserControl>
