<UserControl x:Class="DrSoft.MarkCard.UI.Views.Shape.CurveParamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"     
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"  
             mc:Ignorable="d"          
            Background="#F5F5F5"
           >

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ScrollViewer MinHeight="300"  VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8"
                Orientation="Horizontal" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top">
                <CheckBox Content="封闭形路径" 
           IsChecked="{Binding IsClosedPath}" 
           Style="{StaticResource DrCheckBoxStyle}"/>

                <Button 
                Content="虚线设定"  
            Margin="40,0,0,0"
                Style="{StaticResource SecondActionButtonStyle}" 
                Command="{Binding ShowDialogCommand}"/>

            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch"/>
        <Button  HorizontalAlignment="Right" Grid.Row="1"  Content="套用当前页面" Style="{StaticResource  ActionButtonStyle}" Width="116"  Command="{Binding ApplyCommand}"/>


    </Grid>

</UserControl>
