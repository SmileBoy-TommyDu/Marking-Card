<UserControl x:Class="DrSoft.MarkCard.UI.Views.Shape.CircleParamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d"   >
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ScrollViewer MinHeight="300"  VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <TextBlock Text="圆心(mm)" Style="{StaticResource HeaderLabel}"/>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="X" Style="{StaticResource LabelText}" />
                        <uc:NumericUpDownControl  Width="88" Title="" Unit="" Style="{StaticResource MainNumericUpDown}" Value="{Binding CenterX}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Y" Style="{StaticResource LabelText}" Margin="16,0,4,0"/>
                        <uc:NumericUpDownControl  Width="88" Title="" Unit="" Style="{StaticResource MainNumericUpDown}" Value="{Binding CenterY}" />
                    </StackPanel>
                    <Button  Margin="4,0,0,0" Grid.Column="2"  Background="Transparent" BorderThickness="0"  Command="{Binding GoCenterCommand}" Style="{StaticResource  PressableIconButtonStyle}">
                        <Image  Source="/Resource/image/center0.png" Width="24" Height="24" Stretch="Fill" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <TextBlock Text="半径(mm)" Style="{StaticResource HeaderLabel}"/>

                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="X" Style="{StaticResource LabelText}" />
                        <uc:NumericUpDownControl  Width="88" Style="{StaticResource MainNumericUpDown}" Value="{Binding RadiusX}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2" IsEnabled="{Binding IsEqual, Converter={StaticResource InverseBoolConverter}}">
                        <TextBlock Text="Y" Style="{StaticResource LabelText}" Margin="16,0,4,0"/>
                        <uc:NumericUpDownControl  Width="88" Style="{StaticResource MainNumericUpDown}" Value="{Binding RadiusY}" />
                    </StackPanel>
                </Grid>
                <CheckBox Margin="4,8" Content="设为相等半径" IsChecked="{Binding IsEqual}"  Style="{StaticResource DrCheckBoxStyle}"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch"/>
        <Button HorizontalAlignment="Right" Grid.Row="1"  Content="套用当前页面" Style="{StaticResource  ActionButtonStyle}" Width="116"  Command="{Binding ApplyCommand}"/>


    </Grid>
</UserControl>
