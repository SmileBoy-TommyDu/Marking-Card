<UserControl x:Class="DrSoft.MarkCard.UI.Views.Shape.ArcParamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d" >
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ScrollViewer MinHeight="300"  VerticalScrollBarVisibility="Auto">
            <Grid Margin="8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="弧心" Style="{StaticResource HeaderLabel}"/>

                <uc:NumericUpDownControl Grid.Row="1" Grid.Column="0" Title="X"  Value="{Binding CenterX}"  Style="{StaticResource MainNumericUpDown}"/>

                <uc:NumericUpDownControl Grid.Row="1" Grid.Column="2" Title="Y"  Value="{Binding CenterY}"  Style="{StaticResource MainNumericUpDown}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="半径"   Style="{StaticResource HeaderLabel}"/>
                <CheckBox Grid.Row="2" Grid.Column="2" Content="设为相等半径" IsChecked="{Binding IsEqualRadius}" Style="{StaticResource DrCheckBoxStyle}"/>
                <uc:NumericUpDownControl  Grid.Row="3" Grid.Column="0" Title="X" Unit="mm" Value="{Binding RadiusX}"  Style="{StaticResource MainNumericUpDown}"/>

                <uc:NumericUpDownControl  Grid.Row="3" Grid.Column="2" Title="Y" Unit="mm" Value="{Binding RadiusY}"  Style="{StaticResource MainNumericUpDown}" IsEnabled="{Binding IsEqualRadius, Converter={StaticResource InverseBoolConverter}}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="起始角度"   Style="{StaticResource HeaderLabel}"/>
                <uc:NumericUpDownControl Grid.Row="5" Grid.Column="0" Title="A" Unit="度" Value="{Binding StartAngle}"  Style="{StaticResource MainNumericUpDown}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="扫描角度"   Style="{StaticResource HeaderLabel}"/>
                <uc:NumericUpDownControl Grid.Row="5" Grid.Column="2" Title="A" Unit="度" Value="{Binding EndAngle}" Style="{StaticResource MainNumericUpDown}"/>

            </Grid>
        </ScrollViewer>

        <Grid Margin="8" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="4" Grid.Row="0" Grid.Column="0" Text="起始点" Style="{StaticResource HeaderLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="X" Style="{StaticResource LabelText}" />
            <uc:NumericUpDownControl  Margin="0,2" Grid.Row="1" Grid.Column="1" Value="{Binding StartX}"   Style="{StaticResource SeconedNumericUpDown}"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Y" Style="{StaticResource LabelText}" />
            <uc:NumericUpDownControl  Margin="0,2" Grid.Row="1" Grid.Column="4"  Value="{Binding StartY}"    Style="{StaticResource SeconedNumericUpDown}"/>

            <TextBlock   Grid.Row="2" Grid.Column="0" Text="角度" Style="{StaticResource LabelText}"  />
            <uc:NumericUpDownControl Margin="0,2" IsEnabled="False" Grid.Row="2" Grid.Column="1" Value="{Binding StartAngle}"   Style="{StaticResource SeconedNumericUpDown}"/>


            <TextBlock Grid.ColumnSpan="4" Grid.Row="3" Grid.Column="0"  Text="中间点" Style="{StaticResource HeaderLabel}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="X" Style="{StaticResource LabelText}" />
            <uc:NumericUpDownControl  Margin="0,2" Grid.Row="4" Grid.Column="1" Value="{Binding MiddleX}"    Style="{StaticResource SeconedNumericUpDown}"/>

            <TextBlock Grid.Row="4" Grid.Column="3" Text="Y" Style="{StaticResource LabelText}" />
            <uc:NumericUpDownControl  Margin="0,2" Grid.Row="4" Grid.Column="4" Value="{Binding MiddleY}"   Style="{StaticResource SeconedNumericUpDown}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="角度" Style="{StaticResource LabelText}" />
            <uc:NumericUpDownControl Margin="0,2" IsEnabled="False"  Grid.Row="5" Grid.Column="1" Value="{Binding MiddleAngle}"   Style="{StaticResource SeconedNumericUpDown}"/>

            <TextBlock Grid.ColumnSpan="4" Grid.Row="6" Grid.Column="0"  Text="终止点" Style="{StaticResource HeaderLabel}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="X" Style="{StaticResource LabelText}" />
            <uc:NumericUpDownControl Margin="0,2" Grid.Row="7" Grid.Column="1" Value="{Binding EndX}"    Style="{StaticResource SeconedNumericUpDown}"/>

            <TextBlock Grid.Row="7" Grid.Column="3" Text="Y" Style="{StaticResource LabelText}" />
            <uc:NumericUpDownControl Margin="0,2" Grid.Row="7" Grid.Column="4" Value="{Binding EndY}"   Style="{StaticResource SeconedNumericUpDown}"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="角度" Style="{StaticResource LabelText}" />
            <uc:NumericUpDownControl Margin="0,2" IsEnabled="False"  Grid.Row="8" Grid.Column="1" Value="{Binding EndAngle}"   Style="{StaticResource SeconedNumericUpDown}"/>

        </Grid>
        <Border Grid.Row="1" BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch"/>
        <Button  HorizontalAlignment="Right" Grid.Row="1"   Content="套用当前页面" Style="{StaticResource  ActionButtonStyle}" Width="116"  Command="{Binding ApplyCommand}"/>


    </Grid>
</UserControl>
