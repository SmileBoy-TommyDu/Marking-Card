<UserControl x:Class="DrSoft.MarkCard.UI.Views.LayerInputIOView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F5F5F5"
             Foreground="#2A2C2B"
             d:DesignHeight="420" d:DesignWidth="328">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,4">
                <Border Style="{StaticResource IOBoard}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" Color="#000000" BlurRadius="10" Direction="315" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="输入状态" Style="{StaticResource MainHeaderLabel}"/>
                        <ItemsControl ItemsSource="{Binding InputList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="4" Columns="4" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="4,6" Style="{StaticResource DrCheckBoxStyle}"  Content="{Binding Index}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsUsed}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="逾期时间(ms)" Style="{StaticResource MainHeaderLabel}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="120" Height="24" VerticalContentAlignment="Center"
                             Background="#EAEAEA" BorderThickness="0" Padding="5,0"
                             Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#E60012" Text="*-1指无限等待"/>
                </StackPanel>

                <RadioButton Margin="0,8,0,0" GroupName="InputMode" Content="等待图层输入"
                             Style="{StaticResource DrRadioButtonStyle}"
                             IsChecked="{Binding IsWaitLayerInput}"/>
                <RadioButton Margin="0,6,0,0" GroupName="InputMode" Content="匹配图层输入"
                             Style="{StaticResource DrRadioButtonStyle}"
                             IsChecked="{Binding IsWaitLayerInput}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch"/>
        <Button Grid.Row="1" HorizontalAlignment="Right" Content="套用当前页面"
                Style="{StaticResource ActionButtonStyle}" Width="116" Command="{Binding ApplyCommand}"/>
    </Grid>
</UserControl>
