<UserControl x:Class="DrSoft.MarkCard.UI.Views.FillParamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:conv="clr-namespace:DrSoft.MarkCard.UI.Converters"
            xmlns:rules="clr-namespace:DrSoft.MarkCard.UI.ValidationRules"
            xmlns:i="http://schemas.microsoft.com/xaml/behaviors"  
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
            mc:Ignorable="d" 
            Background="Transparent">
    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter1" IsInverse="True"/>
    </UserControl.Resources>

    <Grid Background="#f5f5f5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ScrollViewer  VerticalScrollBarVisibility="Auto">
            <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 颜色和样式 -->
                <RowDefinition Height="Auto"/>
                <!-- 弹出的占位 -->
                <RowDefinition Height="Auto"/>
                <!-- 底部按钮 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶部颜色和基本样式 -->
            <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="填满颜色" Style="{StaticResource TitleRight}" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="120"  HorizontalAlignment="Left" Margin="4,0,0,0" Style="{StaticResource DrComboxStyle}" SelectedIndex="{Binding Model.FillStyleIndex}">
                    <ComboBoxItem Content="填满实线"/>
                    <ComboBoxItem Content="填满短虚线"/>
                    <ComboBoxItem Content="填满点虚线"/>
                </ComboBox>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="4" Margin="4,0,0,0"
            Background="{Binding FillColor, Converter={StaticResource HexColorToBrushConverter}, Mode=TwoWay}" 
            BorderBrush="Gray" 
            BorderThickness="1"
            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding BorderClickCommand}" CommandParameter="{Binding Model}"/>
                        </Border.InputBindings>
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1"  Text="填满参数" Style="{StaticResource HeaderLabel}"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 标签列 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 输入列 -->
                    <ColumnDefinition Width="Auto"/>

                    <!-- 右侧选项列 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 左侧文本框组 -->
                <TextBlock Grid.Row="0" Text="边距" Style="{StaticResource TitleRight}"/>
                    <uc:NumericUpDownControl Style="{StaticResource MainNumericUpDown}" Title="" Unit="" Grid.Row="0" Grid.Column="1" IsEnabled="{Binding MarginEnable}" Value="{Binding Model.Margin}" Margin="2"/>

                <TextBlock   Grid.Row="1" Text="形式" Style="{StaticResource TitleRight}" />
                <!--<ComboBox x:Name="FillTypeComboBox" Grid.Row="1" Grid.Column="1" Width="120"  SelectedIndex="{Binding Model.FillTypeIndex, Mode=TwoWay}" Style="{StaticResource DrComboxStyle}" Margin="2">
                    <ComboBoxItem Content="Z字型单向"/>
                    <ComboBoxItem Content="弓字型双向"/>
                    <ComboBoxItem Content="回字型"/>
                    <ComboBoxItem Content="螺旋型"/>

                    -->
                <!-- 添加交互触发器 -->
                <!--
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding FillTypeChangedCommand}"
                            CommandParameter="{Binding ElementName=FillTypeComboBox, Path=SelectedIndex}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>-->

                <ComboBox x:Name="FillTypeComboBox" Grid.Row="1" Grid.Column="1" Width="120" ItemsSource="{Binding FillTypeOptions}"  SelectedIndex="{Binding Model.FillTypeIndex, Mode=TwoWay}" Style="{StaticResource DrComboxStyle}" Margin="2">
                    <!-- 添加交互触发器 -->
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding FillTypeChangedCommand}"
              CommandParameter="{Binding ElementName=FillTypeComboBox, Path=SelectedIndex}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>

                <TextBlock Grid.Row="2" Text="圈距" Style="{StaticResource TitleRight}"/>
                <uc:NumericUpDownControl Style="{StaticResource MainNumericUpDown}" Title="" Unit=""  Grid.Row="2" Grid.Column="1" IsEnabled="{Binding RingSpacingEnable}" Value="{Binding Model.RingSpacing}" Margin="2"/>


                <TextBlock Grid.Row="3" Text="间距" Style="{StaticResource TitleRight}"/>
                <uc:NumericUpDownControl Style="{StaticResource MainNumericUpDown}" Title="" Unit=""  Grid.Row="3" Grid.Column="1" IsEnabled="{Binding LineSpacingEnable}" Value="{Binding Model.LineSpacing}" Margin="2"/>


                <TextBlock Grid.Row="4" Text="内圈数" Style="{StaticResource TitleRight}" />
                <uc:NumericUpDownControl Style="{StaticResource MainNumericUpDown}" Title="" Unit=""  Grid.Row="4"  Grid.Column="1"  IsEnabled="{Binding InternalRingsEnable}" Value="{Binding Model.InternalRings}" Margin="2"/>


                <TextBlock Grid.Row="5" Text="起始角度" Style="{StaticResource TitleRight}"/>
                <uc:NumericUpDownControl Style="{StaticResource MainNumericUpDown}" Title="" Unit=""  Grid.Row="5" Grid.Column="1" IsEnabled="{Binding StartAngleEnable}" Value="{Binding Model.StartAngle}" Margin="2"/>


                <TextBlock Grid.Row="6" Text="延伸" Style="{StaticResource TitleRight}"/>
                <uc:NumericUpDownControl Style="{StaticResource MainNumericUpDown}" Title="" Unit=""  Grid.Row="6" Grid.Column="1" IsEnabled="{Binding ExtensionEnable}" Value="{Binding Model.Extension}" Margin="2"/>

                <Button Margin="10,0,0,0"  HorizontalAlignment="Left" Grid.Row="7" Grid.Column="1"  Name="SettingsButton" Content="虚线设定"  Visibility="{Binding IsModifyFill, Converter={StaticResource BoolToVisibilityConverter}}"   Style="{StaticResource SecondActionButtonStyle}" Width="116"  Command="{Binding ShowDialogCommand}"/>
                <!-- 右侧选项组 -->


                <CheckBox Style="{StaticResource DrCheckBoxStyle}" Grid.Row="2" Grid.Column="2" IsEnabled="{Binding AverageDistributeEnable}" Content="平均分配" IsChecked="{Binding Model.AverageDistribute}" Margin="4,0,0,0"/>



                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                    <!-- 回字型（同心圆）的选项 -->
                    <ComboBox x:Name="ConcentricComboBox"
                              Width="120" 
                              Style="{StaticResource DrComboxStyle}"
              IsEnabled="{Binding DirectionTypeIndexEnable}"
              SelectedIndex="{Binding Model.DirectionTypeIndex}"
              Visibility="{Binding IsConcentricFill, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBoxItem Content="向内，固定起点"/>
                        <ComboBoxItem Content="向外，固定起点"/>
                        <ComboBoxItem Content="向内，变动起点"/>
                        <ComboBoxItem Content="向外，变动起点"/>
                        <ComboBoxItem Content="向内向外，变动起点"/>
                        <ComboBoxItem Content="向外向内，变动起点"/>
                    </ComboBox>
                    <!-- 螺旋型的选项 -->
                    <ComboBox x:Name="SpiralComboBox"
                              Width="120"    
                              Style="{StaticResource DrComboxStyle}"
              IsEnabled="{Binding DirectionTypeIndexEnable}" 
              SelectedIndex="{Binding Model.DirectionTypeIndex}"
              Visibility="{Binding IsSpiralFill, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBoxItem Content="向内"/>
                        <ComboBoxItem Content="向外"/>
                        <ComboBoxItem Content="向内再向外"/>
                        <ComboBoxItem Content="向外再向内"/>
                    </ComboBox>
                </StackPanel>

                <CheckBox Grid.Row="5" Grid.Column="2" Content="相对物件角度" IsEnabled="{Binding RelativeToAngleEnable}" IsChecked="{Binding Model.RelativeToAngle}" Style="{StaticResource DrCheckBoxStyle}" Margin="4,0,0,0"/>
                <CheckBox Grid.Row="6" Grid.Column="2" Content="填满线反向" IsEnabled="{Binding ReverseFillLineEnable}" IsChecked="{Binding Model.ReverseFillLine}" Style="{StaticResource DrCheckBoxStyle}" Margin="4,0,0,0"/>

            </Grid>

        </Grid>
            </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" Visibility="{Binding IsModifyFill, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Stretch"/>
        <Button  HorizontalAlignment="Right" Grid.Row="1"  Name="ApplyButton" Content="套用当前页面"  Visibility="{Binding IsModifyFill, Converter={StaticResource BoolToVisibilityConverter}}"   Style="{StaticResource  ActionButtonStyle}" Width="116"  Command="{Binding UpdateCommand}"/>
        <Border Grid.Row="1" BorderBrush="#E2E2E2" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch" Visibility="{Binding IsModifyFill, Converter={StaticResource BoolToVisibilityConverter1}}"/>
    </Grid>

</UserControl>