<UserControl x:Class="DrSoft.MarkCard.UI.Views.Calibrate.GalvoParamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.Calibrate"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d" 
               Foreground="#2a2c2b"
  FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
        <RowDefinition Height="2"/>
            <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        
    </Grid.RowDefinitions>

    <Border BorderBrush="#E0E0E0" BorderThickness="1" ></Border>

        <TextBlock Grid.Row="1" Text="振镜XY轴方向判断" FontSize="12" Margin="0 4 0 0" Foreground="#858e90" FontWeight="Bold"/>

        <Grid Margin="0 4 0 0" Grid.Row="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧: 振镜XY轴方向判断 -->

                <Border BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="4" Background="#eeeeee">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="2" Color="#80000000" Opacity="0.2" Direction="135"/>
                    </Border.Effect>
                <StackPanel Margin="5">
                    <CheckBox Content="X轴反向" IsChecked="{Binding XAxisReverse}" Style="{StaticResource DrCheckBoxStyle}" Margin="0,3"/>
                        <CheckBox Content="Y轴反向" IsChecked="{Binding YAxisReverse}" Margin="0,3" Style="{StaticResource DrCheckBoxStyle}"/>
                        <CheckBox Content="XY轴反转" IsChecked="{Binding XYAxisReverse}" Margin="0,3" Style="{StaticResource DrCheckBoxStyle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="空走" Width="80" Margin="0,0,10,0" Command="{Binding DryRunCommand}" Style="{StaticResource ActionButtonStyle}" Visibility="Collapsed"/>
                            <Button Content="1 生成图形" Width="80" Margin="0,0,8,0" Command="{Binding CreateGraphicsCommand}" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="2 雕刻图形" Width="80" Margin="0" Command="{Binding MarkGraphicsCommand}" Style="{StaticResource SecondActionButtonStyle}"/>
                    </StackPanel>


                </StackPanel>
                </Border>


                <!-- 预览区域 -->
                <Grid Grid.Column="1" Margin="4,0,0,0">
                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Height="150">
                        <Canvas>
                            <!-- X轴 -->
                            <Line X1="20" Y1="80" X2="130" Y2="80" Stroke="Black" StrokeThickness="1.5"/>
                            <!-- X轴箭头 -->
                            <Polygon Points="130,75 140,80 130,85" Fill="Black"/>
                            <!-- X+ 标注 -->
                            <TextBlock Canvas.Left="140" Canvas.Top="70" Text="X+" FontSize="16" FontWeight="Bold" Foreground="Black"/>
                            <!-- Y轴 -->
                            <Line X1="80" Y1="135" X2="80" Y2="30" Stroke="Black" StrokeThickness="1.5"/>
                            <!-- Y轴箭头 -->
                            <Polygon Points="75,30 80,20 85,30" Fill="Black"/>
                            <!-- Y+ 标注 -->
                            <TextBlock Canvas.Left="88" Canvas.Top="16" Text="Y+" FontSize="16" FontWeight="Bold" Foreground="Black"/>
                        </Canvas>
                    </Border>
                   
                </Grid>

                <!-- 右侧: 比例因子设置 --><!--
            <GroupBox Grid.Column="1" Header="比例因子设置" Margin="10,0,0,0" Visibility="Collapsed">
                <StackPanel Margin="5">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="直线长度" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <uc:NumericInputControl Grid.Column="1" Value="{Binding LineLength}" Unit="mm"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
