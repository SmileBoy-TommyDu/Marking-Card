        </Grid>

        <!-- 底部按钮 -->
        <!--<StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="套用" Width="80" Height="30" Command="{Binding SaveCommand}"/>
        </StackPanel>-->

            <Border Grid.Row="2" >
                <StackPanel Orientation="Horizontal" 
HorizontalAlignment="Right" 
Margin="0,8,8,8">
                    <Button Content="应用"  Command="{Binding SaveCommand}"

Style="{StaticResource ActionButtonStyle}"
Width="74" Height="24" FontSize="13"/>
                    <Button Content="取消" 
Command="{Binding CancelCommand}"
Width="74" Height="24" FontSize="13"
    Margin="-4,6,8,0"
Style="{StaticResource SecondActionButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    
    </Grid>
</UserControl>
