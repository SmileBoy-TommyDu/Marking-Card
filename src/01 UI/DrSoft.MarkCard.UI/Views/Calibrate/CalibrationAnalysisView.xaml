<UserControl x:Class="DrSoft.MarkCard.UI.Views.Calibrate.CalibrationAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.Calibrate"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d" 
              Foreground="#2a2c2b"
FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#E0E0E0" BorderThickness="1" ></Border>
        <!-- 单文件误差校正文件 -->
        <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <TextBlock Text="二次元测量结果"  FontSize="12" Margin="0 4 0 0" Foreground="#858e90" FontWeight="Bold"/>
            <Grid Margin="0 4 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ErrorCalibrationFilePath}" IsReadOnly="True" Style="{StaticResource RoundedTextBoxStyle}" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="..." Style="{StaticResource ImportButtonStyle}" Command="{Binding ImportCommand}"/>
            </Grid>
        </StackPanel>

        <!-- 参数设置 -->
        <Grid Grid.Row="2" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="校正幅面" VerticalAlignment="Center" Margin="0,0,0,0" HorizontalAlignment="Left"/>
            <uc:NumericUpDownControl Grid.Row="0" Width="120" Grid.Column="1" HorizontalAlignment="Left" Value="{Binding TotalArea}" Unit="mm"/>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="校正阶数" VerticalAlignment="Center" Margin="40,0,4,0"/>
     
                <ComboBox 
                          HorizontalAlignment="Left"
                          Width="120"
                          Grid.Row="0" Grid.Column="4"
                          Style="{StaticResource DrComboxStyle}"
                          ItemsSource="{Binding AvailableStages}"
                          SelectedItem="{Binding CalibrationStage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                
          

            <TextBlock Grid.Row="1" Grid.Column="0" Text="放大倍数" VerticalAlignment="Center" Margin="0,0,0,0"/>
           
                <ComboBox Width="120" Grid.Row="1" Grid.Column="1"
                          Style="{StaticResource DrComboxStyle}"
                          ItemsSource="{Binding AvailableMagnifications}"
                          SelectedItem="{Binding Magnification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          

            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource ActionButtonStyle}" Margin="40 0 0 0" Content="计算" Width="60" Command="{Binding CalculateCommand}"/>
            <Button Grid.Row="1" Grid.Column="4" Margin="10,0,0,0" Content="导出图片" Style="{StaticResource SecondActionButtonStyle}" Width="70"  Click="ExportChartButton_Click" HorizontalAlignment="Left"/>
        </Grid>

        <!-- 图表区域 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- X方向/Y方向 选项卡 -->
            <TabControl x:Name="DirectionTabControl"
                        Grid.Row="0"
                        SelectedIndex="{Binding SelectedDirectionIndex}"
                        SizeChanged="DirectionTabControl_SizeChanged">
                <TabItem Header="X方向">
                    <Border x:Name="XDirectionChartBorder" Height="300" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                        <Canvas x:Name="XDirectionCanvas" ClipToBounds="True">
                            <Line X1="50" Y1="20" X2="50" Y2="280" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="50" Y1="280" X2="{Binding AxisXRight}" Y2="280" Stroke="Black" StrokeThickness="1"/>

                            <!-- 坐标轴单位标题 -->
                            <TextBlock Canvas.Left="6" Canvas.Top="4" Text="{Binding YAxisTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock Canvas.Right="-30" Canvas.Top="286" Text="{Binding XAxisTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>

                            <ItemsControl ItemsSource="{Binding XDirectionYAxisTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- Y 轴刻度线 -->
                                            <Line X1="{Binding TickX1}" Y1="{Binding TickY1}" X2="{Binding TickX2}" Y2="{Binding TickY2}" Stroke="Black" StrokeThickness="1"/>
                                            <!-- Y 轴刻度标签：右对齐贴在 Y 轴左侧 -->
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Width="{Binding LabelWidth}" TextAlignment="Right"
                                                       Margin="{Binding LabelMargin}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding XDirectionXAxisTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- X 轴刻度线 -->
                                            <Line X1="{Binding TickX1}" Y1="{Binding TickY1}" X2="{Binding TickX2}" Y2="{Binding TickY2}" Stroke="Black" StrokeThickness="1"/>
                                            <!-- X 轴刻度标签：水平居中对齐刻度线 -->
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Width="{Binding LabelWidth}" TextAlignment="Center"
                                                       Margin="{Binding LabelMargin}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding XDirectionPlotPoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="12" Height="12" Background="Transparent" Margin="-6,-6,0,0">
                                            <Ellipse Width="4" Height="4" Fill="Blue" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </TabItem>
                <TabItem Header="Y方向">
                    <Border x:Name="YDirectionChartBorder" Height="300" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                        <Canvas ClipToBounds="True">
                            <Line X1="50" Y1="20" X2="50" Y2="280" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="50" Y1="280" X2="{Binding AxisXRight}" Y2="280" Stroke="Black" StrokeThickness="1"/>

                            <!-- 坐标轴单位标题 -->
                            <TextBlock Canvas.Left="6" Canvas.Top="4" Text="{Binding YAxisTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock Canvas.Right="-30" Canvas.Top="286" Text="{Binding XAxisTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>

                            <ItemsControl ItemsSource="{Binding YDirectionYAxisTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Line X1="{Binding TickX1}" Y1="{Binding TickY1}" X2="{Binding TickX2}" Y2="{Binding TickY2}" Stroke="Black" StrokeThickness="1"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Width="{Binding LabelWidth}" TextAlignment="Right"
                                                       Margin="{Binding LabelMargin}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding YDirectionXAxisTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Line X1="{Binding TickX1}" Y1="{Binding TickY1}" X2="{Binding TickX2}" Y2="{Binding TickY2}" Stroke="Black" StrokeThickness="1"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Width="{Binding LabelWidth}" TextAlignment="Center"
                                                       Margin="{Binding LabelMargin}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding YDirectionPlotPoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="12" Height="12" Background="Transparent" Margin="-6,-6,0,0">
                                            <Ellipse Width="4" Height="4" Fill="Blue" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                </TabItem>
                <TabItem Header="热力图">
                    <Border x:Name="HeatmapChartBorder" Height="314" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                        <Canvas ClipToBounds="True">
                            <Line X1="50" Y1="20" X2="50" Y2="280" Stroke="Black" StrokeThickness="1"/>
                            <Line X1="50" Y1="280" X2="{Binding AxisXRight}" Y2="280" Stroke="Black" StrokeThickness="1"/>

                            <!-- 坐标轴单位标题 -->
                            <TextBlock Canvas.Left="6" Canvas.Top="4" Text="{Binding HeatmapYAxisTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock Canvas.Right="0" Canvas.Top="296" Text="{Binding HeatmapXAxisTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#555"/>

                            <Image x:Name="HeatmapImage"
                                   Source="{Binding HeatmapImageSource}" Stretch="Fill"
                                   Canvas.Left="70" Canvas.Top="20"
                                   Width="{Binding PlotXRangeValue}" Height="250"
                                   MouseMove="HeatmapImage_MouseMove"
                                   MouseLeave="HeatmapImage_MouseLeave"/>

                            <Border Canvas.Left="{Binding HeatmapHoverCanvasX}"
                                    Canvas.Top="{Binding HeatmapHoverCanvasY}"
                                    Visibility="{Binding HeatmapHoverVisibility}"
                                    Background="#EE1E1E1E"
                                    BorderBrush="#FF3A3A3A"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6"
                                    IsHitTestVisible="False">
                                <TextBlock Text="{Binding HeatmapHoverLabel}" Foreground="White" FontSize="11"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding HeatmapYAxisTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Line X1="{Binding TickX1}" Y1="{Binding TickY1}" X2="{Binding TickX2}" Y2="{Binding TickY2}" Stroke="Black" StrokeThickness="1"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Width="{Binding LabelWidth}" TextAlignment="Right"
                                                       Margin="{Binding LabelMargin}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding HeatmapXAxisTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Line X1="{Binding TickX1}" Y1="{Binding TickY1}" X2="{Binding TickX2}" Y2="{Binding TickY2}" Stroke="Black" StrokeThickness="1"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Width="{Binding LabelWidth}" TextAlignment="Center"
                                                       Margin="{Binding LabelMargin}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Canvas.Right="10" Canvas.Top="2" Text="{Binding HeatmapMaxLabel}" FontSize="10" Foreground="Red"/>
                        </Canvas>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
