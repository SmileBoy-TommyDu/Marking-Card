<UserControl x:Class="DrSoft.MarkCard.UI.Views.Calibrate.CalibrateProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.Calibrate"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             Foreground="#2a2c2b"
             FontSize="14"
             mc:Ignorable="d" 
            >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="231"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#E0E0E0" BorderThickness="1" ></Border>
        
        <!-- 校正工艺参数 -->
        <TextBlock Grid.Row="1" Text="校正工艺参数" FontSize="12" Margin="0 4 0 0" Foreground="#858e90" FontWeight="Bold"/>
        
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- 第一行: 标刻速度、功率 -->
            <TextBlock Grid.Row="0" Grid.Column="0"  Text="标刻速度" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Grid.Row="0" Grid.Column="1" Width="120" Value="{Binding MarkSpeed}" Unit="mm/ms"/>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="激光功率" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="0" Grid.Column="4" Value="{Binding Power}" Unit="%"/>

            <!-- 第二行: 跳转速度、频率 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="位移速度" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="1" Grid.Column="1" Value="{Binding JumpSpeed}" Unit="mm/ms"/>
            
            <TextBlock Grid.Row="1" Grid.Column="3" Text="激光频率" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="1" Grid.Column="4" Value="{Binding Frequency}" Unit="kHz"/>

            <!-- 第三行: 开光延时、占空比 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="起始点延迟" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="2" Grid.Column="1" Value="{Binding LaserOnDelay}" Unit="ms"/>
            
            <TextBlock Grid.Row="2" Grid.Column="3" Text="脉宽" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="2" Grid.Column="4" Value="{Binding DutyCycle}" Unit="%"/>

            <!-- 第四行: 关光延时、结束延时 -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="终止点延迟" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="3" Grid.Column="1" Value="{Binding LaserOffDelay}" Unit="ms"/>

            <TextBlock Grid.Row="3" Grid.Column="3" Text="雕刻延迟" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="3" Grid.Column="4" Value="{Binding MarkDelay}" Unit="ms"/>

            <!-- 第五行: 跳转延时、拐角延时 -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="位移延迟" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="4" Grid.Column="1" Value="{Binding JumpDelay}" Unit="ms"/>
            
            <TextBlock Grid.Row="4" Grid.Column="3" Text="拐角延迟" VerticalAlignment="Center" Margin="0,0,4,0" HorizontalAlignment="Right"/>
            <uc:NumericUpDownControl Width="120" Grid.Row="4" Grid.Column="4" Value="{Binding CornerDelay}" Unit="ms"/>
        </Grid>

        <!-- 导入校正文件 -->
        <StackPanel Grid.Row="3">
            <TextBlock Text="导入校正档" FontWeight="Bold" FontSize="12" Margin="0 4 0 4" Foreground="#858e90"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Width="382" Style="{StaticResource RoundedTextBoxStyle}" Text="{Binding CalibrationFilePath}" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,0,0" />
                <Button Grid.Column="1" Content="..." Margin="0" Width="24" Command="{Binding ImportCommand}" Style="{StaticResource ImportButtonStyle}" Cursor="Hand"/>
            </Grid>
        </StackPanel>

        <!-- 底部按钮 --><!--
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="套用" Width="80" Height="30" Command="{Binding SaveCommand}"/>
        </StackPanel>-->

        <Border Grid.Row="4" >
            <StackPanel Orientation="Horizontal" 
     HorizontalAlignment="Right" 
     Margin="0,8,8,8">
                <Button Content="应用"  Command="{Binding SaveCommand}"

     Style="{StaticResource ActionButtonStyle}"
     Width="74" Height="24" FontSize="13"/>
                <Button Content="取消" 
     Command="{Binding CancelCommand}"
     Width="74" Height="24" FontSize="13"
         Margin="-4,6,8,0"
     Style="{StaticResource SecondActionButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
