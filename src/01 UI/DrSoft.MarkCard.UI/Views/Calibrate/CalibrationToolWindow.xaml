<Window x:Class="DrSoft.MarkCard.UI.Views.Calibrate.CalibrationToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:calibrate="clr-namespace:DrSoft.MarkCard.UI.Views.Calibrate"
        mc:Ignorable="d"
        Title="校正工具" Height="560" Width="480"
         WindowStartupLocation="CenterOwner"
  AllowsTransparency="True"
 WindowStyle="None"
Background="Transparent"
 ResizeMode="NoResize"
 ShowInTaskbar="False">
   

    <Border  Margin="20" >
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0"  Color="#000" Opacity="0.3"/>
        </Border.Effect>
        <Border  CornerRadius="6"
     BorderBrush="#CCCCCC" BorderThickness="1"
     Background="#FFF5F5F5">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                 
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#e2e2e2"
             CornerRadius="5,5,0,0">
                    <Grid Height="32" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                        Text="配置"
                        VerticalAlignment="Center"
                        Margin="12,0"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="#3e4446"/>
                        <Button Grid.Column="1"
                     Content="&#xE711;"
                     FontFamily="Segoe MDL2 Assets"
                     Click="CloseButton_Click"
                     Cursor="Hand"
                     Width="28" Height="28"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="#3e4446"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8E8E8"/>
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Margin="8" x:Name="MainTabControl" SelectedIndex="{Binding SelectedTabIndex}" Style="{StaticResource NoBorderContentTabControl}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            
                            <Setter Property="MinHeight" Value="20"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Background" Value="#e2e2e2"/>
                            <Setter Property="Foreground" Value="#3e4446"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="BackgroundBorder"
                                    CornerRadius="4,4,0,0"
                                                BorderThickness="1 1 1 0"
                                            BorderBrush="#cacaca"
                                    Background="{TemplateBinding Background}" Margin="0 0 4 0">
                                            <Grid x:Name="Root" Width="56" UseLayoutRounding="True" >
                                                <!-- 内容 -->
                                                <ContentPresenter x:Name="ContentSite"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                ContentSource="Header"
                                                Margin="2,0"
                                                TextBlock.TextAlignment="Center"
                                                TextBlock.FontSize="{TemplateBinding FontSize}"
                                                TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1a5eb4" />
                                                <Setter Property="Foreground" Value="#ffffff"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#555555"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                                
                            </Setter>
                        </Style>
                    </TabControl.ItemContainerStyle>
            <!-- 校正工艺设置 -->
                    <TabItem Header="校正工艺">

                        <calibrate:CalibrateProcessView  DataContext="{Binding CalibrateProcessViewModel}"/>
                    </TabItem>

                <!-- 振镜参数设置 -->
                    <TabItem Header="振镜参数">
                        <calibrate:GalvoParamView DataContext="{Binding GalvoParamViewModel}"/>
                    </TabItem>

                   

                    <!-- 多阶校正 -->
            <TabItem Header="多阶校正">
                <calibrate:MultiStageCalibrationView DataContext="{Binding MultiStageCalibrationViewModel}" />
            </TabItem>
                    <!-- 桶形校正 -->
                    <TabItem Header="桶形校正" Visibility="{Binding IsDisplayBarrelColibration,Converter={StaticResource BoolToVisibilityConverter}}" Cursor="Hand">
                        <calibrate:BarrelDistortionView DataContext="{Binding BarrelDistortionViewModel}" />
                    </TabItem>

                    <!-- PT校正 -->
            <!--<TabItem Header="PT校正">
                <calibrate:PTCalibrationView DataContext="{Binding PTCalibration}"/>
            </TabItem>-->

            <!-- 校正数据分析 -->
            <TabItem Header="校正分析">
                <calibrate:CalibrationAnalysisView DataContext="{Binding CalibrationAnalysisViewModel}"/>
            </TabItem>
        </TabControl>
               
            </Grid>
        </Border>
    </Border>
</Window>
