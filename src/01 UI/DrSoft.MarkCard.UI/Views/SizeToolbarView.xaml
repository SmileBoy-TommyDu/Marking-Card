<UserControl x:Class="DrSoft.MarkCard.UI.Views.SizeToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views"
                xmlns:conv="clr-namespace:DrSoft.MarkCard.UI.Converters"   
             xmlns:localuc="clr-namespace:DrSoft.MarkCard.UI.UserControls"
                xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
                xmlns:vm="clr-namespace:DrSoft.MarkCard.UI.ViewModes"
                mc:Ignorable="d"
                x:Name="root" 
                Background="#F5F5F5"  
                d:DesignHeight="380"
                d:DesignWidth="180" >
    <UserControl.Resources>
        <conv:TabIndexToBoolConverter x:Key="TabIndexToBoolConverter"/>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
     
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" 
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
              CanContentScroll="True">
            <Canvas     HorizontalAlignment="Left"   >
                <!-- Tab Icon Row -->

                <uc:IconButton Margin="4,4,0,0"
                               IconImage="pack://application:,,,/Resource/image/shift.png"
                               ToolTip="平移：按输入的 X、Y 偏移量移动选中物件"
                               IsChecked="{Binding SelectedTab, ConverterParameter=0, Converter={StaticResource TabIndexToBoolConverter}}"
                               Command="{Binding SelectTabCommand}"
                               CommandParameter="0" />
                <uc:IconButton Margin="36,4,0,0"
                               IconImage="pack://application:,,,/Resource/image/rotate.png"
                               ToolTip="旋转：设置旋转角度与旋转中心"
                               IsChecked="{Binding SelectedTab, ConverterParameter=1, Converter={StaticResource TabIndexToBoolConverter}}"
                               Command="{Binding SelectTabCommand}"
                               CommandParameter="1" />
                <uc:IconButton Margin="68,4,0,0"
                               IconImage="pack://application:,,,/Resource/image/zoom.png"
                               ToolTip="缩放：按宽度和高度调整选中物件尺寸"
                               IsChecked="{Binding SelectedTab, ConverterParameter=2, Converter={StaticResource TabIndexToBoolConverter}}"
                               Command="{Binding SelectTabCommand}"
                               CommandParameter="2" />
                <uc:IconButton Margin="100,4,0,0"
                               IconImage="pack://application:,,,/Resource/image/tilt.png"
                               ToolTip="倾斜：设置水平和垂直倾斜角度"
                               IsChecked="{Binding SelectedTab, ConverterParameter=3, Converter={StaticResource TabIndexToBoolConverter}}"
                               Command="{Binding SelectTabCommand}"
                               CommandParameter="3" />

                <!-- Tab Content -->

                <ContentControl  IsEnabled="{Binding IsUEnabled}" Cursor="">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <!-- 位移 -->
                                <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Canvas Margin="8,38,0,0">
                                                    <TextBlock Margin="0,4,0,0"  Text="位移" Style="{StaticResource HeaderLabel}"/>
                                                    <StackPanel Margin="0,24,0,0"  Orientation="Vertical">

                                                        <uc:NumericUpDownControl Title="X" Unit=""  Style="{StaticResource  MainNumericUpDown}"   Value="{Binding DataContext.MoveX, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        <uc:NumericUpDownControl Margin="0,4" Title="Y" Unit=""  Style="{StaticResource MainNumericUpDown}"   Value="{Binding DataContext.MoveY, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                                    </StackPanel>
                                                    <TextBlock Margin="0,85,0,0" Text="中心" Style="{StaticResource HeaderLabel}"/>

                                                    <Image Margin="8,110,0,0"  Source="/Resource/image/尺寸方位.png"  />
                                                    <UniformGrid Margin="-8,95,0,0" Columns="3" Rows="3"  >
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MiddleLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Center, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MiddleRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.MoveCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </UniformGrid>

                                                    <Image Margin="86,105,0,0"  Source="/Resource/image/shift_sign.png" Height="80" />

                                                </Canvas>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- 旋转 -->
                                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Canvas Margin="8,38,0,0">
                                                    <TextBlock Margin="0,4,0,0"  Text="旋转(度)"  Style="{StaticResource HeaderLabel}"/>
                                                    <uc:NumericUpDownControl   Margin="0,24,0,0" Title="A" Unit="" Style="{StaticResource MainNumericUpDown}"   Value="{Binding DataContext.RotateAngle, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <!--<TextBlock Margin="0,50,0,0"  Text="实际角度"  Style="{StaticResource HeaderLabel}"/>
                                                    <uc:NumericUpDownControl   Margin="0,74,0,0" Title="A" Unit="" Style="{StaticResource MainNumericUpDown}" IsEnabled="False"   Value="{Binding DataContext.ActRotateAngle, RelativeSource={RelativeSource AncestorType=UserControl}}" />-->
                                                    <TextBlock Margin="0,50,0,0" Text="旋转中心"  Style="{StaticResource HeaderLabel}"/>
                                                    <StackPanel Margin="0,74,0,0" Orientation="Vertical"  IsEnabled="{Binding DataContext.IsLockCenter,RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <uc:NumericUpDownControl  Title="X" Unit="" Style="{StaticResource MainNumericUpDown}"   Value="{Binding DataContext.RotateCenterX, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <uc:NumericUpDownControl Margin="0,4"  Title="Y" Unit="" Style="{StaticResource MainNumericUpDown}"   Value="{Binding DataContext.RotateCenterY, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </StackPanel>
                                                    <Image Margin="8,140,0,0"  Source="/Resource/image/尺寸方位.png"  />
                                                    <UniformGrid Columns="3" Rows="3" Margin="-8,125,0,0" IsEnabled="{Binding DataContext.IsLockCenter, Converter={StaticResource InverseBooleanConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" >
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MiddleLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Center, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MiddleRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}"  Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.RotateCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </UniformGrid>
                                                    <Image Source="/Resource/image/rotate_sign.png" Width="80" Height="80" Margin="86,135,0,0" />


                                                    <CheckBox Margin="0,230,0,0"
                                                              Content="锁定中心"
                                                              ToolTip="锁定中心：启用后使用输入框中的 X、Y 作为旋转中心；关闭后使用九宫格预设位置"
                                                              IsChecked="{Binding DataContext.IsLockCenter, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                                </Canvas>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- 缩放 -->
                                <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Canvas  Margin="8,38,0,0" IsEnabled="{Binding  DataContext.IsScaleEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock  Margin="0,4,0,0" Text="缩放(mm)"   Style="{StaticResource HeaderLabel}"/>

                                                    <uc:ASizeLockUserControl Margin="-10,24,0,0"
                                                       HorizontalAlignment="Left"
                                                       Title=" " 
                                                       Unit=" "
                                                       Width="300"      
                                                       WidthLabel="宽度" 
                                                       HeightLabel="高度" 
                                                       WidthValue="{Binding DataContext.ScaleWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                       HeightValue="{Binding DataContext.ScaleHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                       IsLocked="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"             
                                                       IsLockToggleEnabled="{Binding DataContext.IsLockToggleEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                                    <TextBlock Margin="0,92,0,0" Text="中心"   Style="{StaticResource HeaderLabel}"/>
                                                    <Image Margin="8,120,0,0"  Source="/Resource/image/尺寸方位.png"  />
                                                    <UniformGrid Columns="3" Rows="3" Margin="-8,105,0,0"  >
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MiddleLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Center, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MiddleRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.ScaleCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </UniformGrid>
                                                    <Image Source="/Resource/image/rotate_sign.png" Width="80" Height="80" Margin="86,112,0,0"/>



                                                </Canvas>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- 倾斜 -->
                                <DataTrigger Binding="{Binding SelectedTab}" Value="3">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Canvas  Margin="8,38,0,0" IsEnabled="{Binding  DataContext.IsSkewEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock  Margin="0,4,0,0" Text="倾斜(度)"   Style="{StaticResource HeaderLabel}"/>
                                                    <TextBlock Margin="0,28,0,0"  Text="水平" Style="{StaticResource HeaderLabel}"/>
                                                    <uc:NumericUpDownControl  Margin="32,24,0,0"   Title="" Unit="" Style="{StaticResource MainNumericUpDown}"   Value="{Binding DataContext.SkewHorizontal, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                                    <TextBlock Margin="0,56,0,0"  Text="垂直" Style="{StaticResource HeaderLabel}"/>
                                                    <uc:NumericUpDownControl   Margin="32,52,0,0"   Title=""  Unit="" Style="{StaticResource MainNumericUpDown}"   Value="{Binding DataContext.SkewVertical, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                                    <TextBlock   Margin="0,84,0,0"   Text="中心"   Style="{StaticResource HeaderLabel}"/>

                                                    <Image Margin="8,112,0,0"  Source="/Resource/image/尺寸方位.png"  />
                                                    <UniformGrid Columns="3" Rows="3" Margin="-8,100,0,0" >

                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16"  IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TopRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MiddleLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Center, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MiddleRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <RadioButton Style="{StaticResource DrRadioButtonStyle}" Margin="8" Width="16" Height="16" IsChecked="{Binding DataContext.SkewCenter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BottomRight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </UniformGrid>
                                                    <Image Source="/Resource/image/shift_sign.png" Width="80" Height="80" Margin="86,108,0,0"/>



                                                </Canvas>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                    </ContentControl.Style>
                </ContentControl>


            </Canvas>
        </ScrollViewer>

        <Grid Grid.Row="1">
            <Border BorderBrush="#E2E2E2" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch"/>
            <StackPanel MinWidth="180" Orientation="Horizontal"  HorizontalAlignment="Right" >

                <Button  Style="{StaticResource SecondActionButtonStyle}" Margin="16,8,8,8" Content="复制并套用" Width="88" Height="24" Command="{Binding DataContext.CopyAndApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Button  Style="{StaticResource ActionButtonStyle}" Margin="8,8,8,8" Content="套用"  Width="60" Height="24"  Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>

        </Grid>
    </Grid>




</UserControl>
