<UserControl x:Class="DrSoft.MarkCard.UI.Views.EditMenu.InversePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.EditMenu"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d">

    <Grid Margin="12,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0"
                  Content="反转"
                  IsChecked="{Binding IsInverse}"
                  Margin="0,0,0,12"
                  VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
            <uc:IconButton Width="146" Height="104"
                           IconWidth="84.38" IconHeight="54"
                          
                           GroupName="InverseDirection"
                           Style="{StaticResource LargeIconButton}"
                           IconImage="pack://application:,,,/Resource/image/Edit/mark_direction1.png"
                           IsChecked="{Binding IsClockwise}"/>
            <uc:IconButton Width="146" Height="104"
                           Margin="4 0 0 0"
                           IconWidth="84.38" IconHeight="54"
                           GroupName="InverseDirection"
                           Style="{StaticResource LargeIconButton}"
                           IconImage="pack://application:,,,/Resource/image/Edit/mark_direction2.png"
                           IsChecked="{Binding IsClockwise,Converter={StaticResource InverseBoolConverter}}"/>
        </StackPanel>
    </Grid>

</UserControl>
