<UserControl x:Class="DrSoft.MarkCard.UI.Views.EditMenu.SkyWritingPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.EditMenu"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d" 
            >

        <Grid>
            
            <StackPanel Orientation="Vertical" Margin="0 0 0 0">
            <!--<TextBlock Text="Sky Writing" FontSize="18" Margin="10,0,0,0" TextAlignment="Left" VerticalAlignment="Center"/>-->
                <!--<StackPanel Margin="0 10 0 0"  Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Sky Writing模式" TextAlignment="Right" Width="100" Margin="0 0 10 0" VerticalAlignment="Center"></TextBlock>
                    <ComboBox  Width="100" Height="28" ItemsSource="{Binding SkyWritingModels}" SelectedItem="{Binding Model.SkyWritingModel}" VerticalContentAlignment="Center"/>
                </StackPanel>-->
            <CheckBox Content="启用" IsChecked="{Binding Model.IsEnabled}" Style="{StaticResource DrCheckBoxStyle}" Margin="118 8 0 0" />
                <StackPanel Margin="0 4 0 0" Orientation="Horizontal" >
                <TextBlock Text="时滞" TextAlignment="Right" Width="110" FontSize="14" Foreground="#2a2c2b"  VerticalAlignment="Center"></TextBlock>

                <uc:NumericUpDownControl Width="120" Title="" DecimalPlaces="2"  Value="{Binding Model.DelayTime}" Margin="8 0 0 0" Unit="µs"/>
                </StackPanel>
                <StackPanel Margin="0 4 0 0" Orientation="Horizontal" >
                <TextBlock Text="开光补偿" TextAlignment="Right" Width="110" FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center"></TextBlock>
                    <uc:NumericUpDownControl Value="{Binding Model.LaserOnDelay}" DecimalPlaces="0"  Margin="8 0 0 0" Title="" Width="120"  Unit="µs"/>
                </StackPanel>
                <StackPanel Margin="0 4 0 0" Orientation="Horizontal" >
                <TextBlock Text="Run-in时间" TextAlignment="Right" Width="110"   FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center"></TextBlock>

                <uc:NumericUpDownControl Value="{Binding Model.RunInTime}" DecimalPlaces="0"  Margin="8 0 0 0" Title="" Width="120"  Unit="µs"/>
                </StackPanel>
                <StackPanel Margin="0 4 0 0" Orientation="Horizontal">
                <TextBlock Text="Run-out时间" TextAlignment="Right" Width="110" FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center"></TextBlock>

                <uc:NumericUpDownControl Value="{Binding Model.RunOutTime}" DecimalPlaces="0"  Margin="8 0 0 0" Title="" Width="120"  Unit="µs"/>
                </StackPanel>
                <StackPanel Margin="0 4 0 0" Orientation="Horizontal" >
                <TextBlock Text="极限夹角" TextAlignment="Right" Width="110" FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center"></TextBlock>
                <uc:NumericUpDownControl Value="{Binding Model.ExtremeAngle}" DecimalPlaces="2" MinValue="0" MaxValue="180" Margin="8 0 0 0" Title="" Width="120"  Unit="度"/>
                </StackPanel>

            </StackPanel>
            <!--<TextBlock  Grid.Row="13" Text="RTC" FontSize="20" Width="100" TextAlignment="Center" Margin="10 0 0 0" Background="Orange" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>-->

            <!--<StackPanel Orientation="Vertical" Grid.Column="1" Margin="18 20 0 0" HorizontalAlignment="Left">
                <TextBlock FontSize="14" TextWrapping="Wrap" Width="380">
                    模式 0：关闭Sky Writing
                </TextBlock>
                <TextBlock FontSize="14" TextWrapping="Wrap" Width="380" Margin="0 6 0 0">
                     模式 1：标准模式,为每一个独立的 Mark 指令执行完整的物理助跑
                </TextBlock>
                <TextBlock FontSize="14" TextWrapping="Wrap" Width="380" Margin="0 6 0 0">
                    模式 2：时间优化模式,消除相邻向量间的物理助跑运动，用更快的“空跳”代替
                </TextBlock>
                <TextBlock FontSize="14" TextWrapping="Wrap" Width="380" Margin="0 6 0 0">
                    模式 3：智能切换模式,在小角度转折时不进行 Sky Writing，以提高效率
                </TextBlock>
            </StackPanel>-->

        <Border HorizontalAlignment="Left" Width="77" Background="#f7b500" Height="32" CornerRadius="2" VerticalAlignment="Bottom" Margin="10 0 0 -34">
            <Border.Effect>
               
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2a2c2b" FontSize="14">RTC</TextBlock>
        </Border>
       
        </Grid>
</UserControl>
