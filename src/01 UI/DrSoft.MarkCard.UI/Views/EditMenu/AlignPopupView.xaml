<UserControl x:Class="DrSoft.MarkCard.UI.Views.EditMenu.AlignPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.EditMenu" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
           >





        <StackPanel Orientation="Vertical" Margin="12 12 0 0">
            <!-- 对齐按钮区域 -->

            <StackPanel Orientation="Horizontal" Cursor="">
                <ToggleButton Width="36" Height="36" Style="{StaticResource DistToggle}"
                                    ToolTip="左对齐" Content="pack://application:,,,/DrSoft.MarkCard.UI;component/Resource/image/Edit/align_left.png" IsChecked="{Binding IsAlignLeft, Mode=TwoWay}">

                </ToggleButton>
                <ToggleButton Width="36" Height="36"  Style="{StaticResource DistToggle}"
                                    ToolTip="水平居中" Content="pack://application:,,,/DrSoft.MarkCard.UI;component/Resource/image/Edit/align_center.png" Tag="AlignCenter" IsChecked="{Binding IsAlignCenter, Mode=TwoWay}">

                </ToggleButton>
                <ToggleButton Width="36" Height="36"  Style="{StaticResource DistToggle}"
                                    ToolTip="右对齐"  Content="pack://application:,,,/DrSoft.MarkCard.UI;component/Resource/image/Edit/align_right.png" IsChecked="{Binding IsAlignRight, Mode=TwoWay}">

                </ToggleButton>
                <ToggleButton Width="36" Height="36" Style="{StaticResource DistToggle}"
                                    ToolTip="顶部对齐" Content="pack://application:,,,/DrSoft.MarkCard.UI;component/Resource/image/Edit/align_top.png" IsChecked="{Binding IsAlignTop, Mode=TwoWay}">

                </ToggleButton>
                <ToggleButton Width="36" Height="36"  Style="{StaticResource DistToggle}"
                                    ToolTip="垂直居中" Content="pack://application:,,,/DrSoft.MarkCard.UI;component/Resource/image/Edit/align_middle.png" IsChecked="{Binding IsAlignMiddle, Mode=TwoWay}"/>
                <ToggleButton Width="36" Height="36"  Style="{StaticResource DistToggle}"
                                    ToolTip="底部对齐" Content="pack://application:,,,/DrSoft.MarkCard.UI;component/Resource/image/Edit/align_bottom.png" IsChecked="{Binding IsAlignBottom, Mode=TwoWay}" Cursor="Hand"/>


            </StackPanel>


            <!-- 对齐至标签 -->
            <TextBlock Text="对齐至" FontSize="12" Margin="0,10,0,5"/>

            <!-- 对齐选项 -->
            <UniformGrid  Rows="1" HorizontalAlignment="Left">
                <RadioButton GroupName="AlignStandard" Content="最后所选对象" Style="{StaticResource DrRadioButtonStyle}" Margin="0,0,20,5" IsChecked="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding AlignStandardRadioCheckedCommand}" CommandParameter="LastChooseOne"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </RadioButton>
                <RadioButton GroupName="AlignStandard" Content="页面边缘" Style="{StaticResource DrRadioButtonStyle}" Margin="0,0,20,5">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding AlignStandardRadioCheckedCommand}" CommandParameter="PageEdge"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </RadioButton>
                <RadioButton GroupName="AlignStandard" Content="页面中心" Style="{StaticResource DrRadioButtonStyle}" Margin="0,0,0,5">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding AlignStandardRadioCheckedCommand}" CommandParameter="PageCenter"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </RadioButton>
                <!--<RadioButton GroupName="AlignStandard" Content="基线" Style="{StaticResource DrRadioButtonStyle}" Margin="0,0,20,5">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding AlignStandardRadioCheckedCommand}" CommandParameter="Baseline"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </RadioButton>-->
            </UniformGrid>
        </StackPanel>





</UserControl>
