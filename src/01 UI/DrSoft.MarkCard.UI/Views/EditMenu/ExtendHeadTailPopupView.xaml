<UserControl x:Class="DrSoft.MarkCard.UI.Views.EditMenu.ExtendHeadTailPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.EditMenu"
              xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d" 
             >
   
        <StackPanel Orientation="Vertical" Margin="12 0 0 0">


        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="头延伸"  Margin="0 0 0 0" Width="40" VerticalAlignment="Center"/>
            <uc:NumericUpDownControl Width="120"  Value="{Binding Model.HeadExtendLength}"  Title=""  Unit="mm"></uc:NumericUpDownControl>
         </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="尾延伸"  Margin="0 0 0 0"  Width="40" VerticalAlignment="Center"/>
                <uc:NumericUpDownControl Width="120"  Value="{Binding Model.TailExtendLength}"  Title=""  Unit="mm"></uc:NumericUpDownControl>
        </StackPanel>
    </StackPanel>

</UserControl>
