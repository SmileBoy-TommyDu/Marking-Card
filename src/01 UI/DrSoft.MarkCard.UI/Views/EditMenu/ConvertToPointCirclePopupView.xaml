<UserControl x:Class="DrSoft.MarkCard.UI.Views.EditMenu.ConvertToPointCirclePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.EditMenu"
             mc:Ignorable="d" 
              xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
              >
    <StackPanel Orientation="Vertical" Margin="12 0 0 0">

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Width="30" Text="类型" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ComboBox Grid.Column="3" Width="120" ItemsSource="{Binding ShapeTypeList}" SelectedItem="{Binding ShapeTypeSelected}" Style="{StaticResource DrComboxStyle}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Grid.Column="1" Text="间距" VerticalAlignment="Center" Width="30" HorizontalAlignment="Center"/>
            <uc:NumericUpDownControl Width="120" Title="" Unit="mm" MinValue="0" Value="{Binding Gap,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <!--<TextBlock Grid.Column="5" Text="{Binding GapTextError}" Foreground="Red"/>-->
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding IsDiameterEnabled}">
                
            <TextBlock  Text="直径" Width="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <uc:NumericUpDownControl Width="120" Title="" Unit="mm" MinValue="0" Value="{Binding Diameter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
            <!--<TextBlock Grid.Column="5" Text="{Binding DiameterTextError}" Foreground="Red"/>-->
         </StackPanel>

        <Border CornerRadius="4" BorderBrush="#E2E2E2" BorderThickness="1" Margin="0 8 0 0" Width="294" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Left">
            <StackPanel  Orientation="Vertical">
                <CheckBox  Content="转角要落点" FontSize="14" IsChecked="{Binding NeedPointAtCornner}" Foreground="#2a2c2b" Margin="0,4,0,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">

                    <TextBlock Width="54" Text="夹角上限" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <uc:NumericUpDownControl Width="120" Title="" Unit="度" MinValue="0" MaxValue="180" Value="{Binding IncludedAngle, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                    <!--<TextBlock Grid.Column="5" Text="{Binding IncludedAngleTextError}" Foreground="Red"/>-->
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
  
</UserControl>
