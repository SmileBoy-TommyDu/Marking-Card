<Window x:Class="DrSoft.MarkCard.UI.Views.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Debug Log"
        Width="900"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="EnableDebugCheckBox"
                      Content="开启调试"
                      FontSize="13"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource TextBrush}"
                      Checked="EnableDebugCheckBox_OnChecked"
                      Unchecked="EnableDebugCheckBox_OnUnchecked"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button Width="96"
                        Height="30"
                        Content="刷新栈"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondActionButtonStyle}"
                        Click="RefreshUndoRedoButton_OnClick"/>
                <Button Width="96"
                        Height="30"
                        Content="清空日志"
                        Style="{StaticResource SecondActionButtonStyle}"
                        Margin="8,0,0,0"
                        Click="ClearLogButton_OnClick"/>
                <Button Width="96"
                         Height="30"
                         Content="弹出提示"
                         Style="{StaticResource SecondActionButtonStyle}"
                         Margin="8,0,0,0"
                         Click="ShowTipButton_Click"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Logs">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderThickness="1"
                         Padding="8"
                         Background="#101113"
                         Foreground="#D8DEE9"/>
            </TabItem>

            <TabItem Header="Undo / Redo">
                <Grid Background="#101113">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="8,8,8,4">
                        <TextBlock x:Name="UndoRedoCanvasLabelTextBlock"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#D8DEE9"/>
                        <TextBlock x:Name="UndoRedoCountsLabelTextBlock"
                                   Margin="0,4,0,0"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#8FBCBB"/>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="8"
                                CornerRadius="4"
                                Background="#16181C"
                                BorderBrush="#2A2D33"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="UndoSectionTitleTextBlock"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#ECEFF4"/>
                                    <TextBlock x:Name="UndoSectionSummaryTextBlock"
                                               Margin="12,0,0,0"
                                               Foreground="#88C0D0"/>
                                </DockPanel>

                                <ListBox x:Name="UndoEntriesListBox"
                                         Grid.Row="1"
                                         Margin="0,8,0,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#D8DEE9"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="8"
                                CornerRadius="4"
                                Background="#16181C"
                                BorderBrush="#2A2D33"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="RedoSectionTitleTextBlock"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#ECEFF4"/>
                                    <TextBlock x:Name="RedoSectionSummaryTextBlock"
                                               Margin="12,0,0,0"
                                               Foreground="#88C0D0"/>
                                </DockPanel>

                                <ListBox x:Name="RedoEntriesListBox"
                                         Grid.Row="1"
                                         Margin="0,8,0,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#D8DEE9"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
