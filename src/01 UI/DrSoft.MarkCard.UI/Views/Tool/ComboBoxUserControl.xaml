<UserControl x:Class="DrSoft.MarkCard.UI.Views.Tool.ComboBoxUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views.Tool"
             mc:Ignorable="d">
    <StackPanel>
    <!-- 使用自定义样式的 ComboBox -->
        <ComboBox x:Name="ComboBox" Width="120" Style="{StaticResource DrComboxStyle}" Margin="6">
            <ComboBoxItem Content="微软雅黑"/>
            <ComboBoxItem Content="宋体"/>
    </ComboBox>
         
    </StackPanel>
</UserControl>
