<UserControl x:Class="DrSoft.MarkCard.UI.Views.Tool.TextFontNumericUpDownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="ValueImage"
                Source="{Binding ImageUrl, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="24" Height="24"
                Visibility="{Binding IsShowContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <uc:NumericUpDownControl x:Name="NumericUpDownBtn" DecimalPlaces="1" MinValue="0" Value="{Binding CurrentNumber, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Row="2" Grid.Column="1" Width="80" Style="{StaticResource MainNumericUpDown}"/>
    </StackPanel>
</UserControl>
