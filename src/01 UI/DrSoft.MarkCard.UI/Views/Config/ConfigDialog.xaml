<Window x:Class="DrSoft.MarkCard.UI.Views.Config.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:config="clr-namespace:DrSoft.MarkCard.UI.Views.Config"
        mc:Ignorable="d"
           xmlns:uc="clr-namespace:DrSoft.MarkCard.UI.UserControls"
        Title="配置" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
         AllowsTransparency="True"
        WindowStyle="None"
       Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- TreeViewItem 自定义模板，覆盖默认系统高亮色 -->
        <ControlTemplate x:Key="ConfigTreeViewItemTemplate" TargetType="TreeViewItem">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="Expander" Grid.Column="0"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Width="16" Height="16" Margin="0,0,4,0">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="16">
                                                    <!--<Path x:Name="ExpandPath"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 4 2 L 10 6 L 4 10 Z"
                                                          Fill="#666666"/>-->
                                                    <Image x:Name="ExpandPath" Source="/Resource/image/unselect_unexpand.png"></Image>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- 选中 + 展开: selected_expand -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            <Condition Binding="{Binding (config:TreeViewHelper.IsEffectivelySelected), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="ExpandPath" Property="Source" Value="/Resource/image/selected_expand.png"/>
                                                    </MultiDataTrigger>
                                                    <!-- 未选中 + 展开: unselect_expand -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            <Condition Binding="{Binding (config:TreeViewHelper.IsEffectivelySelected), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="ExpandPath" Property="Source" Value="/Resource/image/unselect_expand.png"/>
                                                    </MultiDataTrigger>
                                                    <!-- 选中 + 未展开: selected_unexpand -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                                            <Condition Binding="{Binding (config:TreeViewHelper.IsEffectivelySelected), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="ExpandPath" Property="Source" Value="/Resource/image/selected_unexpand.png"/>
                                                    </MultiDataTrigger>
                                                    <!-- 未选中 + 未展开: unselect_unexpand (默认) -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                                            <Condition Binding="{Binding (config:TreeViewHelper.IsEffectivelySelected), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="ExpandPath" Property="Source" Value="/Resource/image/unselect_unexpand.png"/>
                                                    </MultiDataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                          ContentSource="Header"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"
                                Margin="16,0,0,0"
                                Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#eeeeee"/>
                    <Setter Property="Foreground" Value="#1a5eb4"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#eeeeee"/>
                    <Setter Property="Foreground" Value="#1a5eb4"/>
                </Trigger>
                <Trigger Property="config:TreeViewHelper.HasSelectedChild" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#eeeeee"/>
                    <Setter Property="Foreground" Value="#1a5eb4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- TreeViewItem Style -->
        <Style x:Key="ConfigTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#eeeeee"/>
            <Setter Property="Template" Value="{StaticResource ConfigTreeViewItemTemplate}"/>
        </Style>
        <Style x:Key="ConfigTreeViewItemLevel2Style" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="#eeeeee"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="-8 0 0 0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource ConfigTreeViewItemTemplate}"/>
        </Style>
    </Window.Resources>

    <Border  Margin="20" >
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0"  Color="#000" Opacity="0.3"/>
        </Border.Effect>
        <Border  CornerRadius="6"
         BorderBrush="#CCCCCC" BorderThickness="1"
         Background="#F5F5F5">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#e2e2e2"
                 CornerRadius="5,5,0,0">
                    <Grid Height="32" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                            Text="配置"
                            VerticalAlignment="Center"
                            Margin="12,0"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#3e4446"/>
                        <Button Grid.Column="1"
                         Content="&#xE711;"
                         FontFamily="Segoe MDL2 Assets"
                         Click="CloseButton_Click"
                         Cursor="Hand"
                         Width="28" Height="28"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="#3e4446"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8E8E8"/>
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <Grid  Grid.Row="1" Margin="10 10 10 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="124"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel - TreeView -->
                        <Border Grid.Column="0" Background="#eeeeee" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Border 
                                 CornerRadius="3"
                                  Opacity="1"
                                 IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.1">
                                            <GradientStop Color="#33000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.08"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border 
                                 CornerRadius="3"
                                 Opacity="1"
                                 IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,0">
                                            <GradientStop Color="#33000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.08"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TreeView x:Name="ConfigTreeView" 
                                       Background="Transparent" 
                                       Margin="2 4 0 0"
                                       BorderThickness="0"
                                       config:TreeViewHelper.EnableParentHighlight="True"
                                       SelectedItemChanged="ConfigTreeView_SelectedItemChanged">

                                    <!-- 系统 -->
                                    <TreeViewItem Header="系统" IsExpanded="True" Style="{StaticResource ConfigTreeViewItemStyle}" Cursor="Hand">
                                        <TreeViewItem Header="系统设置" IsExpanded="True" Style="{StaticResource ConfigTreeViewItemLevel2Style}"/>
                                        <!--<TreeViewItem Header="格点与微调" Style="{StaticResource ConfigTreeViewItemLevel2Style}"/>-->
                                        <TreeViewItem Header="自动化流程" Style="{StaticResource ConfigTreeViewItemLevel2Style}"/>
                                    </TreeViewItem>
                                    <!-- 打标卡 -->
                                    <TreeViewItem Header="打标卡" Style="{StaticResource ConfigTreeViewItemStyle}"/>
                                    <!-- 扫描头 -->
                                    <TreeViewItem Header="扫描头" Style="{StaticResource ConfigTreeViewItemStyle}"/>
                                    <!-- 激光器 -->
                                    <TreeViewItem Header="激光器" Style="{StaticResource ConfigTreeViewItemStyle}"/>
                                    <!-- 输入输出 -->
                                    <TreeViewItem Header="输入输出" Style="{StaticResource ConfigTreeViewItemStyle}">
                                        <TreeViewItem Header="输入" Style="{StaticResource ConfigTreeViewItemLevel2Style}"/>
                                        <TreeViewItem Header="输出" Style="{StaticResource ConfigTreeViewItemLevel2Style}"/>
                                    </TreeViewItem>
                                    <!-- 功率计 -->
                                    <TreeViewItem Header="功率计" Style="{StaticResource ConfigTreeViewItemStyle}"/>
                                    <!-- 导入/导出 -->
                                    <TreeViewItem Header="导入/导出" Style="{StaticResource ConfigTreeViewItemStyle}"/>
                                </TreeView>
                            </Grid>

                        </Border>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Right Panel - Content -->
                        <Border Grid.Column="2" Background="#eeeeee" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Border 
                                     CornerRadius="3"
                                      Opacity="1"
                                     IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.1">
                                            <GradientStop Color="#33000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.08"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border 
                                 CornerRadius="3"
                                 Opacity="1"
                                 IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.06,0">
                                            <GradientStop Color="#33000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.08"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentControl Content="{Binding SelectedContent}"/>
                            </Grid>

                        </Border>
                    </Grid>


                </Grid>

                <Border Grid.Row="2" >
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,8,8,8">
                        <Button Content="应用"  Command="{Binding ApplyCommand}"
    
                        Style="{StaticResource ActionButtonStyle}"
                        Width="74" Height="24" FontSize="13"
                        Margin="8,8,0,0"/>
                        <Button Content="取消" 
                        Command="{Binding CancelCommand}"
                        Width="74" Height="24" FontSize="13"
                        Margin="6,8,8,0"
                        Style="{StaticResource SecondActionButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
