<UserControl x:Class="DrSoft.MarkCard.UI.Views.Config.GridMicroAdjustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:DrSoft.MarkCard.UI.UserControls"
           xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             Background="Transparent">
    <UserControl.Resources>
        <local:DoubleConverter x:Key="DoubleConverter"/>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical" Margin="8 8 8 8">


        <Border Background="{StaticResource MyBorderGradient}" Height="20">
            <TextBlock Grid.Row="0" Text="格点与微调" Margin="4 0 0 0" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff"/>
        </Border>

        <!-- Grid Settings Section -->
        <TextBlock Margin="0 8 0 0" Foreground="#858e90" Text="格点设置(mm)" FontSize="12" FontWeight="SemiBold"/>

        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
            


            <uc:NumericUpDownControl Width="120" Title="X" DecimalPlaces="0" Value="{Binding GridSpacingX,Mode=TwoWay}" MinValue="10" MaxValue="1000" Unit="" />


            <uc:NumericUpDownControl Width="120" Margin="10 0 0 0" Title="Y" DecimalPlaces="0"  Value="{Binding GridSpacingY}" Unit="" MinValue="10" MaxValue="1000" />
        </StackPanel>

        <!-- Micro Adjust Section -->
        <TextBlock Margin="0 8 0 0" Foreground="#858e90" Text="微调设置(mm)" FontSize="12" FontWeight="SemiBold"/>

        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
            


            <uc:NumericUpDownControl Width="120" Value="{Binding MicroAdjustStepX}" Title="X" Unit="" MinValue="0.001" MaxValue="1"/>


            <uc:NumericUpDownControl  Margin="10 0 0 0" Width="120" Value="{Binding MicroAdjustStepY}" Title="Y" Unit="" MinValue="0.001" MaxValue="1"   />

         
        </StackPanel>

        <!-- Micro Adjust Section -->
        <TextBlock Margin="0 8 0 0" Foreground="#858e90" Text="曲线采样(mm)" FontSize="12" FontWeight="SemiBold"/>

        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">


            <uc:NumericUpDownControl Title="精度" DecimalPlaces="3" Width="120" Value="{Binding Resolution,Mode=TwoWay}" MinValue="0.001" MaxValue="1" Unit="mm" />

        </StackPanel>

    </StackPanel>
</UserControl>
