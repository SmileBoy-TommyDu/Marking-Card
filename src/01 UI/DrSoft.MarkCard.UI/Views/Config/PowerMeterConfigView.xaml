<UserControl x:Class="DrSoft.MarkCard.UI.Views.Config.PowerMeterConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:DrSoft.MarkCard.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             >
    <UserControl.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical" Margin="8 8 8 8">

        <Border Background="{StaticResource MyBorderGradient}" Height="20">
            <TextBlock Grid.Row="0" Text="功率计" Margin="4 0 0 0" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff"/>
        </Border>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="186"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="14" Foreground="#2a2c2b" Text="功率计型号" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 8 0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding PowerMeterModels}"
                      Style="{StaticResource DrComboxStyle}"
                      Width="184"
                      SelectedItem="{Binding SelectedPowerMeterModel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="3" Text="通讯协议" FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center"  HorizontalAlignment="Right" Margin="0 0 8 0"/>
            <ComboBox Grid.Column="4" Width="120" 
                      Style="{StaticResource DrComboxStyle}"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding ConnectTypes}"
                      SelectedItem="{Binding SelectedConnectType}"/>
        </Grid>

        <TextBlock FontSize="12" Foreground="#858e90" FontWeight="SemiBold" Margin="0,4,0,0" Text="测试连接"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                
                <ColumnDefinition Width="121"/>
               
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="120"/>
        
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="通讯地址" VerticalAlignment="Center" FontSize="14" Foreground="#2a2c2b" HorizontalAlignment="Right" Margin="0 0 8 0"/>
            <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBoxStyle}" HorizontalAlignment="Left" Text="{Binding ConnectString, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
            <Button Grid.Column="2" Content="{Binding ConnectButtonText}" Width="44" FontSize="14" Foreground="#2a2c2b" VerticalContentAlignment="Center" FontWeight="Medium" Height="24" Margin="0 0 0 0" Style="{StaticResource SecondActionButtonStyle}" BorderBrush="#979797" Background="#d8d8d8" Command="{Binding ConnectCommand}"/>
            

            <Image Grid.Column="3" Width="16" Height="16">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="/Resource/image/light_off.png"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Source" Value="/Resource/image/light_on.png"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <!--<TextBlock Grid.Column="8" Text="{Binding ConnectionStatusText}" VerticalAlignment="Center"/>-->

            <TextBlock Grid.Column="4" Text="反馈数值" VerticalAlignment="Center" FontSize="14" Foreground="#2a2c2b" HorizontalAlignment="Right" Margin="0 0 8 0"/>
            <TextBox Grid.Column="5" Text="{Binding FeedbackValue}" Style="{StaticResource RoundedTextBoxStyle}"  IsReadOnly="True" 
         Background="#F0F0F0"/>
        </Grid>

       
    </StackPanel>
</UserControl>
