<UserControl x:Class="DrSoft.MarkCard.UI.Views.Config.MarkCardConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:DrSoft.MarkCard.UI.Converters"
              xmlns:controls="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
            xmlns:model="clr-namespace:DrSoft.MarkCard.Model.Enum;assembly=DrSoft.MarkCard.Model"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700"
              Background="Transparent">
    <UserControl.Resources>

        <conv:IndexToSelectedBrushConverter x:Key="IndexToSelectedBrushConverter"/>
        <conv:IndexToSelectedForegroundConverter x:Key="IndexToSelectedForegroundConverter"/>

        <conv:EnumDescriptionConverter x:Key="EnumDescConv" />

 
        <ObjectDataProvider x:Key="IOTrigerProvider" MethodName="GetValues" ObjectType="{x:Type model:IOTriggerType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:IOTriggerType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

  

        <Style TargetType="DataGrid">

            <Setter Property="Background" Value="#F0F0F0"/>
            <!-- 浅灰色背景 -->
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <!-- 边框颜色 -->
            <Setter Property="RowHeight" Value="30"/>
            <!-- 行高 -->
            <Setter Property="HeadersVisibility" Value="Column"/>
            <!-- 仅显示列头 -->
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <!-- 禁止自动生成列 -->
            <Setter Property="CanUserAddRows" Value="False"/>
            <!-- 禁止新增行 -->
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <!-- 禁止删除行 -->
            <Setter Property="IsReadOnly" Value="False"/>
            

        </Style>

        
    </UserControl.Resources>
    <Grid Margin="8 8 8 8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
          
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource MyBorderGradient}" Height="20" VerticalAlignment="Top">
            <TextBlock Grid.Row="0" Text="打标卡" Margin="4 0 0 0" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff"/>
        </Border>

        <!-- Card Tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding CardTypeCounts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Name="bd" Margin="0 0 6 0">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource IndexToSelectedBrushConverter}">
                                    <Binding/>
                                    <Binding Path="DataContext.SelectedCardTypeIndex" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </MultiBinding>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#CACACA" />
                                    <Setter Property="CornerRadius" Value="4,4,0,0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                                
                            </Border.Style>
                            
                          
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Content="{Binding }"
                                   BorderThickness="0" BorderBrush="{x:Null}" 
                                    Width="60" Height="28" Margin="0,0,0,0" FontSize="12"
                                    Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='卡类型{0}'}" />
                                    </DataTemplate>
                                </Button.ContentTemplate>
                                <Button.Background>
                                    <MultiBinding Converter="{StaticResource IndexToSelectedBrushConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.SelectedCardTypeIndex" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </Button.Background>
                                <Button.Foreground>
                                    <MultiBinding Converter="{StaticResource IndexToSelectedForegroundConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.SelectedCardTypeIndex" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </Button.Foreground>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3,0,0,0"
                                                            Padding="8,4">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C8D8EC"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="20"
                                    Height="28"
                                    Margin="-4,0,0,0"
                                    Padding="0"
                                    Content="×"
                                    BorderThickness="0" 
                                    BorderBrush="{x:Null}"
                                    FontSize="12"
                                    Command="{Binding DataContext.RemoveCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="移除卡类型">
                                <Button.Background>
                                    <MultiBinding Converter="{StaticResource IndexToSelectedBrushConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.SelectedCardTypeIndex" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </Button.Background>
                                <Button.Foreground>
                                    <MultiBinding Converter="{StaticResource IndexToSelectedForegroundConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.SelectedCardTypeIndex" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </Button.Foreground>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="0,3,0,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3C6C6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                   
                                </Button>
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                   
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>
            <Border  CornerRadius="6 6 0 0" BorderThickness="1" BorderBrush="#cacaca" Background="#e2e2e2">
            <Button Content="+" Width="30" Height="28" BorderThickness="0" Command="{Binding AddCardCommand}" FontSize="16"/>
            </Border>
        </StackPanel>

        <!-- Content Area -->
        <Border  Grid.Row="4" BorderBrush="#cacaca" Background="#f5f5f5" BorderThickness="1">
            <Grid Margin="6 8 8 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Settings -->
                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="#858e90" Text="基础设置" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,0"/>

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="型号" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,5,0"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding MarkCardType}" Width="120" ItemsSource="{Binding MarkCardTypes}" Style="{StaticResource DrComboxStyle}" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="通讯类型" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,5,0"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding ConnectionType}" Width="120" Style="{StaticResource DrComboxStyle}" ItemsSource="{Binding ConnectTypes}" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                   
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="超时时间" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,5,0"/>
                        <!--<TextBox Grid.Column="1"  Text="{Binding MarkingTimeout, UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Width="100" VerticalContentAlignment="Center"/>-->
                        <controls:NumericUpDownControl Grid.Column="1" Width="120" Value="{Binding MarkingTimeout}" Unit="ms" MinValue="0" MaxValue="1000000"
Height="28" VerticalContentAlignment="Center"/>
                   
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
     
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="初始化超时" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,0,0"/>


                        <controls:NumericUpDownControl Grid.Column="1"  Value="{Binding InitTimeout}" Width="120" Unit="ms" MinValue="0" MaxValue="1000000"
/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <TextBlock Text="激活" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,5,0"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsActivated}" Content="是" VerticalAlignment="Center" Style="{StaticResource DrCheckBoxStyle}"/>
                    </Grid>

                    <TextBlock Text="IO触发模式" Foreground="#858e90" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模式" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,5,0"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding IoTriggerMode}" ItemsSource="{Binding IOTriggerTypes}" VerticalContentAlignment="Center" Style="{StaticResource DrComboxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 这里的 DataContext 是当前的枚举项 -->
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescConv}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>


                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启用" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,5,0"/>
                        <CheckBox IsChecked="{Binding IOTriggerEnabled}" Grid.Column="1" Content="是" VerticalAlignment="Center" Style="{StaticResource DrCheckBoxStyle}"/>
                    </Grid>

                    <TextBlock Text="打标卡数量" Foreground="#858e90" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数量" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" Margin="0,0,5,0"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding CardCount}" Style="{StaticResource DrComboxStyle}" ItemsSource="{Binding CardCounts}" Height="28" VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Right Table -->

                <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0 22 0 0">
                    <Border x:Name="dgClipMask" CornerRadius="6,6,0,0" Background="Black"/>
                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=dgClipMask}"/>
                        </Grid.OpacityMask>
               <DataGrid  AutoGenerateColumns="False" ItemsSource="{Binding Cards}"
                          CanUserAddRows="False" CanUserDeleteRows="False" 
                          BorderThickness="1 1 1 0"
                         BorderBrush="#A4AAAC"
                         RowBackground="#d8d8d8"
                         GridLinesVisibility="Horizontal"
                        
                         HorizontalGridLinesBrush="#a4aaac"
                         ColumnHeaderStyle="{StaticResource CustomColumnHeaderStyle}"
                         >
                        <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding SequenceNumber,StringFormat={}{0:D2}}" ElementStyle="{StaticResource CenterTextStyle}" Width="40" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="通讯设置" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ConnectionSetting, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsConnectionSettingEditable}"
                                                 ToolTip="{Binding ConnectionSettingHint}"
                                                 Style="{StaticResource RoundedTextBoxStyle}"
                                                 Width="88"
                                                 Height="24"
                                                HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                                />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="一卡多头" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ScanHeadCounts}"
                                                  SelectedItem="{Binding ScanHeadCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DrComboxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--<DataGridCheckBoxColumn Header="主卡" Binding="{Binding IsMaster, UpdateSourceTrigger=PropertyChanged}" Width="60"/>-->
                        <DataGridTemplateColumn Header="主卡" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox 
                      IsChecked="{Binding IsMaster, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Style="{StaticResource DrCheckBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Grid>
              
            </Grid>
        </Border>
    </Grid>
</UserControl>
