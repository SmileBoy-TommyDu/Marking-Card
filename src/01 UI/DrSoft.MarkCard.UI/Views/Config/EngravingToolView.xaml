<UserControl x:Class="DrSoft.MarkCard.UI.Views.Config.EngravingToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             mc:Ignorable="d"
                  Background="#F5F5F5"
        d:DesignHeight="420"
        d:DesignWidth="328">
   
    
    <Grid >
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            --><!-- 自动雕刻 --><!--
            <GroupBox Header="自动雕刻" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <CheckBox Content="启动" IsChecked="{Binding AutoEngraveEnabled}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="延迟" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBox Text="{Binding DelaySeconds}" Style="{StaticResource InputTextBoxStyle}"/>
                            <TextBlock Text="S" Style="{StaticResource InfoLabelStyle}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <CheckBox Content="显示雕刻时间与次数" IsChecked="{Binding ShowEngraveTimeAndCount}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="雕刻次数" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBox Text="{Binding EngraveCount}" Style="{StaticResource InputTextBoxStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            --><!-- 雕刻时间 --><!--
            <GroupBox Header="雕刻时间" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="全部" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TotalTime}" Style="{StaticResource InfoTextBoxStyle}"/>
                </Grid>
            </GroupBox>
            
            --><!-- 雕刻数量 &  --><!--
            <GroupBox Header="雕刻数量" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="完成量" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CompletedCount}" Style="{StaticResource InfoTextBoxStyle}"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="总完成量" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TotalCompletedCount}" Style="{StaticResource InfoTextBoxStyle}"/>
                </Grid>
            </GroupBox>
            
            --><!-- 雕刻模式 --><!--
            <GroupBox Header="雕刻模式" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="全部" IsChecked="{Binding EngraveModeAll}" GroupName="EngraveMode" Margin="0,0,16,0"/>
                    <RadioButton Content="已选取" IsChecked="{Binding EngraveModeSelected}" GroupName="EngraveMode" Margin="0,0,8,0"/>
                 
                </StackPanel>
            </GroupBox>
            <GroupBox Header="" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Orientation="Horizontal">
                 
                    <Button Content="下发" Command="{Binding PreviewCommand}" Background="#6090D0" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="执行" Command="{Binding ExecuteCommand}" Background="#50B050" Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="停止" Command="{Binding PauseCommand}" Background="#EA0000" Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>-->

        <StackPanel Orientation="Vertical" Margin="8">
            <!--<CheckBox Content="启动" Style="{StaticResource DrCheckBoxStyle}" IsChecked="{Binding AutoEngraveEnabled}" Margin="0,0,0,8"/>-->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="延迟时间" FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center" />
                <uc:NumericUpDownControl Value="{Binding DelaySeconds}" Width="120" Unit="S" MinValue="0" Margin="10 0 0 0"/>
              
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="雕刻次数" FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center" />
                <uc:NumericUpDownControl Value="{Binding EngraveCount}" Width="120" DecimalPlaces="0"  Unit="次" MinValue="1" Margin="10 0 0 0"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="预计时间" FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center" />
                <uc:NumericUpDownControl Value="{Binding EstimatedTime}" Width="120" DecimalPlaces="3" IsEnabled="False"  Unit="S" MinValue="0" Margin="10 0 0 0"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="雕刻时间" FontSize="14" Foreground="#2a2c2b" VerticalAlignment="Center" />
                <uc:NumericUpDownControl Value="{Binding TotalTime}" Width="120" DecimalPlaces="3" IsEnabled="False"  Unit="S" MinValue="0" Margin="10 0 0 0"/>

            </StackPanel>
            <TextBlock Text="雕刻模式" FontSize="12" Margin="0,0,0,4" Foreground="#858e90" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton Content="全部" IsChecked="{Binding EngraveModeAll}" Style="{StaticResource DrRadioButtonStyle}" GroupName="EngraveMode" Margin="0,0,16,0"/>
                <RadioButton Content="已选取" IsChecked="{Binding EngraveModeSelected}" Style="{StaticResource DrRadioButtonStyle}" GroupName="EngraveMode" Margin="0,0,8,0"/>

            </StackPanel>
            <StackPanel MinWidth="180" Orientation="Horizontal"  HorizontalAlignment="Left" >

                <Button  Style="{StaticResource SecondActionButtonStyle}" Margin="0,8,4,0" Content="下发" Width="60" Height="24" Command="{Binding LoadMarkDataCommand}"/>
                <Button  Style="{StaticResource ActionButtonStyle}" Background="#2bc852"  Margin="0,8,4,0" Content="执行"  Width="60" Height="24"  Command="{Binding ExecuteCommand}"/>
                <Button  Style="{StaticResource ActionButtonStyle}" Background="#e42828" Margin="0,8,4,0" Content="停止"  Width="60" Height="24"  Command="{Binding StopCommand}"/>
            </StackPanel>
        </StackPanel>
        <!-- 套用按钮 -->
        <!--<Button Grid.Row="2" 
                Content="套用" 
                Command="{Binding ApplyCommand}" 
                Background="#2060A0" 
                Foreground="White" 
                Width="100" 
                Height="32" 
                HorizontalAlignment="Right" 
                Margin="0,8,0,0"
                BorderThickness="0"/>-->
    </Grid>
</UserControl>
