<UserControl x:Class="DrSoft.MarkCard.UI.Views.ToolbarGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI.Views"
             xmlns:models="clr-namespace:DrSoft.MarkCard.UI.Models">

    <UserControl.Resources>

        <!-- 普通按钮：白底，悬停浅蓝灰，按下凹陷 -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width"               Value="24"/>
            <Setter Property="Height"              Value="24"/>
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderBrush"         Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Foreground"          Value="#1F1F1F"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding"             Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0CDE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0DCF5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A0B4DC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle 按钮：选中时橙色背景（对应图中激活状态） -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width"           Value="24"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#1F1F1F"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0CDE8"/>
                            </Trigger>
                            <!-- 选中：橙色，与图片中高亮工具一致 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD580"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E8B840"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#FFCA50"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- 整体横向：[拖拽手柄][按钮行][右侧分隔竖线] -->
    <Border x:Name="GroupBorder"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="1"
        CornerRadius="2"
        Margin="0">
        <DockPanel LastChildFill="False">

            <!-- ① 拖拽手柄：浅灰点阵，悬停变深 -->
            <Border x:Name="DragHandle"
                DockPanel.Dock="Left"
                Width="8"
                Background="Transparent"
                Cursor="SizeWE"
                MouseEnter="DragHandle_MouseEnter"
                MouseLeave="DragHandle_MouseLeave"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                ToolTip="拖动以调整顺序">
                <UniformGrid x:Name="DragDots"
                         Columns="2"
                         Rows="4"
                         Width="6"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False">
                    <Ellipse Width="2" Height="2" Fill="#C8C8C8" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="#C8C8C8" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="#C8C8C8" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="#C8C8C8" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="#C8C8C8" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="#C8C8C8" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="#C8C8C8" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="#C8C8C8" Margin="1"/>
                </UniformGrid>
            </Border>

            <!-- ② 右侧分隔竖线：浅灰，和图片中组间分隔线一致 -->
            <Border x:Name="Separator"
                DockPanel.Dock="Right"
                Width="1"
                Margin="2,2"
                Background="#D8D8D8"/>
            
            <ItemsControl ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 直接呈现 Content 中的任意 UIElement -->
                        <ContentPresenter Content="{Binding Content}"
                                      ToolTip="{Binding Tooltip}"
                                      Margin="0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
