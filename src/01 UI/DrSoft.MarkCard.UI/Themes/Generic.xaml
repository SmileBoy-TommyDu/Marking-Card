    <Style x:Key="DistToggle" TargetType="local:IconToggleButton">
        <Setter Property="Foreground" Value="#555"/>

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:IconToggleButton">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                       
                            <!-- 内阴影模拟层：从左上到右下的半透明黑色渐变，模拟 inset shadow -->
                            <Border x:Name="shadowLayer"
                                CornerRadius="4"
                                Opacity="0"
                                IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,2">
                                        <GradientStop Color="#33000000"  Offset="0"/>
                                        <!--<GradientStop Color="#80FF0000" Offset="0.05"/>-->
                                        <GradientStop Color="#00000000" Offset="0.08"/>
                                    </LinearGradientBrush>

                                </Border.Background>
                            </Border>

                            <Border x:Name="shadowLayer1"
                               CornerRadius="4"
                               Opacity="0"
                               IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="2,0">
                                        <GradientStop Color="#33000000"  Offset="0"/>
                                        <!--<GradientStop Color="#80FF0000" Offset="0.05"/>-->
                                        <GradientStop Color="#00000000" Offset="0.08"/>
                                    </LinearGradientBrush>

                                </Border.Background>
                            </Border>

                        <Border x:Name="bd"  CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid>
                        <Image 
                         
                           x:Name="Arrow" 
                           Source="{Binding Icon,RelativeSource={RelativeSource TemplatedParent}}"   
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"    
                               Stretch="Uniform"
                           Width="24"
                           Height="24"/>

                        <Image 
   
                         x:Name="Active" 
                         Source="{Binding IconActive,RelativeSource={RelativeSource TemplatedParent}}"   
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"    
                               Stretch="Uniform"
                                     
                         Width="24"
                         Height="24"/>

                        </Grid>
                    </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#D9D9D9"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        
                       
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Active" Property="Visibility" Value="Visible"/>
                            
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Active" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="0"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="MyBorderGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF1A5EB4" Offset="0" />
        <GradientStop Color="#261A5EB4" Offset="1" />
    </LinearGradientBrush>

