<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local1="clr-namespace:DrSoft.MarkCard.UI.UserControls"
                    xmlns:local="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI">


    <!-- 1. 定义资源：颜色和几何图形 -->
    <SolidColorBrush x:Key="ColorBorderNormal" Color="#FFD9D9D9"/>
    <SolidColorBrush x:Key="ColorBorderHover" Color="#FF5B9BD5"/>
    <SolidColorBrush x:Key="ColorBorderFocus" Color="#FF1A5EB4"/>
    <SolidColorBrush x:Key="ColorBgReadOnly" Color="#FFE2E2E2"/>
    <SolidColorBrush x:Key="ColorBgWhite" Color="#FFFFFFFF"/>

    <!-- 箭头几何 (向下) -->
    <Geometry x:Key="DownArrowGeometry">M 0 0 L 4 4 L 8 0 Z</Geometry>
    <!-- 箭头几何 (向上 - 选中时) -->
    <Geometry x:Key="UpArrowGeometry">M 0 4 L 4 0 L 8 4 Z</Geometry>

    <!-- 自定义ComboBox样式 -->
    <Style TargetType="{x:Type local:CustomComboBox}">
        <!-- 固定尺寸 -->
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0,20,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsEditable" Value="False"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CustomComboBox}">
                    <Grid>
                        <!-- 触发表单的外边框容器 -->
                        <!-- 
                            重要：VisualStateManager.VisualStateGroups 必须附加到 FrameworkElement 上，
                            这里附加到 Border 控件，而不是 ControlTemplate
                        -->
                        <Border x:Name="Border"
                                Background="#FFFFFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Width="120"
                                Height="24"
                                BorderBrush="#D9D9D9">

                            <!-- 视觉状态管理器 - 必须放在具体的 FrameworkElement 内部 -->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <!-- 原状样式 Normal -->
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" 
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" 
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D9"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>

                                    <!-- 悬停样式 MouseOver -->
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" 
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" 
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#858E90"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>

                                    <!-- 点击样式 Pressed -->
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" 
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" 
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1A5EB4"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>

                                    <!-- 只读样式 ReadOnly -->
                                    <!-- 禁用样式（只读）- 使用标准名称 Disabled -->
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" 
                                               Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#E2E2E2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" 
                                               Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#D9D9D9"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- 阴影效果 - 使用 Effect 实现内阴影效果 -->
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.5" Direction="-135"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 内容显示区域 -->
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  IsHitTestVisible="False"/>

                                <!-- 下拉箭头按钮 -->
                                <ToggleButton x:Name="DropDownToggle"
                                              Grid.Column="1"
                                              Width="20"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Image 
                                                     x:Name="Arrow" 
                                                     Source="/Resource/image/CBdown.png"   
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"    
                                                     Width="22"
                                                     Height="22"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Source" Value="/Resource/image/CBdownS.png"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Source" Value="/Resource/image/CBdownS.png"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- 下拉列表弹出层 -->
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="PopupBorder"
                                    Background="White"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,2,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>
                                <ScrollViewer x:Name="ScrollViewer"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter x:Name="ItemsPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 禁用状态的视觉（只读样式通过VisualState控制）-->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="#E2E2E2"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#D9D9D9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- 下拉列表项样式 -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Height" Value="26"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#E6F0FA"/>
                            <Setter Property="Foreground" Value="#1A5EB4"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:StateButton">
        <!-- 基础属性 -->
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IconWidth" Value="24"/>
        <Setter Property="IconHeight" Value="24"/>
        <Setter Property="Background" Value="#F4F4F4"/>
        <Setter Property="BorderBrush" Value="#5F97CF"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:StateButton">
                    <!-- 外层 Border：开启裁剪，防止内阴影模糊溢出 -->
                    <Border x:Name="PART_Root"                       
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        ClipToBounds="True">
                        <!-- 关键：裁剪溢出内容 -->

                        <Grid>
                            <Border x:Name="InnerShadowBorderX"
                            CornerRadius="4"
                            Opacity="0"
                            IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="2,0">
                                        <GradientStop Color="#33000000"  Offset="0"/>
                                        <!--<GradientStop Color="#80FF0000" Offset="0.05"/>-->
                                        <GradientStop Color="#00000000" Offset="0.08"/>
                                    </LinearGradientBrush>

                                </Border.Background>
                            </Border>

                            <Border x:Name="InnerShadowBorderY"
                             CornerRadius="4"
                             Opacity="0"
                             IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,2">
                                        <GradientStop Color="#33000000"  Offset="0"/>
                                        <!--<GradientStop Color="#80FF0000" Offset="0.05"/>-->
                                        <GradientStop Color="#00000000" Offset="0.08"/>
                                    </LinearGradientBrush>

                                </Border.Background>
                            </Border>

                            <Grid>
                                <!-- 正常图标 -->
                                <Image x:Name="PART_NormalIcon"
                                   Source="{TemplateBinding NormalIcon}"
                                   Width="{TemplateBinding IconWidth}"
                                   Height="{TemplateBinding IconHeight}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                                <!-- 禁用图标 -->
                                <Image x:Name="PART_DisabledIcon"
                                   Source="{TemplateBinding DisabledIcon}"
                                   Width="{TemplateBinding IconWidth}"
                                   Height="{TemplateBinding IconHeight}"
                                   Stretch="Uniform"
                                   Opacity="0.4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                                <!-- 文本内容 -->
                                <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--正常状态下（无交互）隐藏内阴影-->
                        <!-- 
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="InnerShadowBorder" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>

                         -->
                        <!--鼠标悬停：显示黑色内阴影-->
                        <!-- 
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InnerShadowBorder" Property="BorderBrush" Value="#80000000"/>
                        </Trigger>-->

                        <!-- 鼠标按下：显示蓝色内阴影（覆盖悬停色） -->
                        <!--<Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="InnerShadowBorder" Property="BorderBrush" Value="#805F97CF"/>
                        </Trigger>-->

                        <!-- 有内容时：隐藏图标，显示文本 -->
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="PART_NormalIcon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_DisabledIcon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="#D9D9D9"/>
                            <Setter TargetName="PART_Root" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="InnerShadowBorderX" Property="Opacity" Value="1"/>
                            <Setter TargetName="InnerShadowBorderY" Property="Opacity" Value="1"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter TargetName="PART_Root" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="InnerShadowBorderX" Property="Opacity" Value="1"/>
                            <Setter TargetName="InnerShadowBorderY" Property="Opacity" Value="1"/>
                        </Trigger>


                        <!-- 禁用状态：清除所有交互阴影，显示禁用图标 -->
                        <!--
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InnerShadowBorder" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="PART_NormalIcon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_DisabledIcon" Property="Visibility" Value="Visible"/>
                        </Trigger>-->
                        <!--<Trigger Property="IsEnabled" Value="True">
                            <Setter TargetName="InnerShadowBorder" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="PART_NormalIcon" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_DisabledIcon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 为 ImageButton 定义默认样式 -->
    <Style TargetType="local1:ImageButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="100"/>
        <!-- 模板定义不变（Border 绑定依然保留） -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local1:ImageButton">
                    <Grid>
                        <Border x:Name="PART_Background"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="2">
                            <Image x:Name="PART_Image" 
                               Source="{Binding NormalImage, RelativeSource={RelativeSource TemplatedParent}}" 
                               Stretch="Uniform"
                               StretchDirection="Both"/>
                        </Border>
                    </Grid>
                    <!-- 模板内不再需要触发器 -->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- 将触发器放在 Style 层级，直接修改控件的 Background -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" 
                    Value="{Binding HoverBackground, RelativeSource={RelativeSource Self}}"/>
                <!-- 图片切换仍可保留，但需要在模板内或额外处理，此处只改背景 -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- IconButton 默认样式 -->
    <Style TargetType="local:IconButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IconWidth" Value="18"/>
        <Setter Property="IconHeight" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:IconButton">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <!-- 内阴影模拟层：从左上到右下的半透明黑色渐变，模拟 inset shadow -->
                        <Border x:Name="shadowLayer"
                                CornerRadius="4"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,2">
                                    <GradientStop Color="#33000000"  Offset="0"/>
                                    <!--<GradientStop Color="#80FF0000" Offset="0.05"/>-->
                                    <GradientStop Color="#00000000" Offset="0.08"/>
                                </LinearGradientBrush>

                            </Border.Background>
                        </Border>

                        <Border x:Name="shadowLayer1"
                               CornerRadius="4"
                               Opacity="0"
                               IsHitTestVisible="False">    
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="2,0">
                                    <GradientStop Color="#33000000"  Offset="0"/>
                                    <!--<GradientStop Color="#80FF0000" Offset="0.05"/>-->
                                    <GradientStop Color="#00000000" Offset="0.08"/>
                                </LinearGradientBrush>

                            </Border.Background>
                        </Border>

                        <Border x:Name="border"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 图标（优先显示） -->
                                <Image x:Name="PART_Icon"
                                       Source="{Binding IconImage, RelativeSource={RelativeSource TemplatedParent}}"
                                       Width="{TemplateBinding IconWidth}"
                                       Height="{TemplateBinding IconHeight}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Visible"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 无图标或解析失败时回退显示 Content -->
                        

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#D9D9D9"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LargeIconButton" TargetType="local:IconButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="#ffffff"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IconWidth" Value="16"/>
        <Setter Property="IconHeight" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:IconButton">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <!-- 内阴影模拟层：从左上到右下的半透明黑色渐变，模拟 inset shadow -->
                        <Border x:Name="shadowLayer"
                                CornerRadius="4"
                                Opacity="1"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,2">
                                    <GradientStop Color="#33000000"  Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.02"/>
                                </LinearGradientBrush>

                            </Border.Background>
                        </Border>

                        <Border x:Name="shadowLayer1"
                               CornerRadius="4"
                               Opacity="1"
                               IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="2,0">
                                    <GradientStop Color="#33000000"  Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.02"/>
                                </LinearGradientBrush>

                            </Border.Background>
                        </Border>

                        <Border x:Name="border"
                                CornerRadius="4"
                                BorderBrush="#e2e2e2"
                                BorderThickness="1"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 图标（优先显示） -->
                                <Image x:Name="PART_Icon"
                                       Source="{Binding IconImage, RelativeSource={RelativeSource TemplatedParent}}"
                                       Width="{TemplateBinding IconWidth}"
                                       Height="{TemplateBinding IconHeight}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Visible"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 无图标或解析失败时回退显示 Content -->


                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#D9D9D9"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="border" Property="Background" Value="#ffffff"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="border" Property="Background"  Value="#ffffff"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="border" Property="Background"  Value="#ffffff"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="#e2e2e2"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="border" Property="Background"  Value="#ffffff"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NumberDataExpressionTextBox 默认样式 -->
    <Style TargetType="local:NumberDataExpressionTextBox">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="#ffffff"/>
        <Setter Property="BorderBrush" Value="#D9D9D9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#FF000000"/>
        <Setter Property="CaretBrush" Value="#FF000000"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NumberDataExpressionTextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid  Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <!-- 内阴影层：模拟 inset box-shadow (参考 IconButton) -->
                            <Border x:Name="ShadowLayer"
                                    CornerRadius="3"
                                     Opacity="1"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.08"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ShadowLayer1"
                                    CornerRadius="3"
                                    Opacity="1"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,0">
                                        <GradientStop Color="#33000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.08"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- 文本内容 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <TextBlock x:Name="TitleTextBlock"
                                               Margin="8,0,0,0" 
                                               Text="{TemplateBinding Title}" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Center"  
                                               FontSize="{TemplateBinding FontSize}"     
                                               Foreground="#858e90" />
                                    <ScrollViewer Margin="-1,0,0,0" TextBlock.TextAlignment="Left" x:Name="PART_ContentHost"   HorizontalAlignment="Left" VerticalAlignment="Center"  Focusable="false"     HorizontalScrollBarVisibility="Hidden"  VerticalScrollBarVisibility="Hidden"/>
                                </StackPanel>
                                <TextBlock   Margin="4,0,8,0"  Grid.Column="1" Text="{TemplateBinding Unit}"  HorizontalAlignment="Right" VerticalAlignment="Center"  FontSize="{TemplateBinding FontSize}"   Foreground="#858e90"       />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#858E90"/>
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="ShadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- 焦点/选择 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#ffffff"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="ShadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- 只读 -->
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#E2E2E2"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#D9D9D9"/>
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="ShadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- 禁用 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="#E2E2E2"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#D9D9D9"/>
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="ShadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- 当 Title 为空或为 null 时隐藏 TitleTextBlock -->
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleTextBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleTextBlock" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NoTitle" TargetType="local:NumberDataExpressionTextBox">
