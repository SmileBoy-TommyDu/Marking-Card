                            <!-- 内阴影层：模拟 inset box-shadow (参考 IconButton) -->
                            <Border x:Name="ShadowLayer"
                                CornerRadius="3"
                                 Opacity="1"
                                IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.08"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="ShadowLayer1"
                                CornerRadius="3"
                                Opacity="1"
                                IsHitTestVisible="False">
