<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="BackgroundColor">#f5f5f5</Color>
    <Color x:Key="PanelBackgroundColor">#E8E8E8</Color>
    <Color x:Key="CanvasBackgroundColor">#CCCCCC</Color>
    <Color x:Key="BorderColor">#BBBBBB</Color>
    <Color x:Key="HeaderBackgroundColor">#F5F5F5</Color>
    <Color x:Key="SelectedBackgroundColor">#D0E4F7</Color>
    <Color x:Key="AccentColor">#3399FF</Color>
    <Color x:Key="TextColor">#2A2C2B</Color>
    <Color x:Key="DimTextColor">#666666</Color>
    <Color x:Key="TabActiveColor">#FFFFFF</Color>
    <Color x:Key="TabInactiveColor">#DCDCDC</Color>
    <Color x:Key="RulerBackgroundColor">#DADADA</Color>
    <Color x:Key="RulerTickColor">#999999</Color>
    <Color x:Key="ToolbarBgColor">#F7F7F7</Color>
    <Color x:Key="ButtonHoverColor">#D8EAFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="{StaticResource TabActiveColor}"/>
    <SolidColorBrush x:Key="TabInactiveBrush" Color="{StaticResource TabInactiveColor}"/>
    <SolidColorBrush x:Key="RulerBackgroundBrush" Color="{StaticResource RulerBackgroundColor}"/>
    <SolidColorBrush x:Key="ToolbarBgBrush" Color="{StaticResource ToolbarBgColor}"/>

    <!-- Menu Style -->
    <Style x:Key="TopMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource ToolbarBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- MenuItem Style -->
    <!-- MenuItem style used for MainWindow popup items -->
    <Style x:Key="MainWindowMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="#f5f5f5"/>
        <Setter Property="Foreground" Value="#2A2C2B"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Margin="8,0" MinWidth="200" Height="22">
                        <Border x:Name="GutterCover"
                                CornerRadius="2"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"/>
                        <!--<Border x:Name="Bd"
                                CornerRadius="2"
                                Background="{TemplateBinding Background}">
                        </Border>-->
                        <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                 ContentSource="Header"
                                                 VerticalAlignment="Center"
                                                 Margin="4,0"
                                                 RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="1"
                                          Text="{TemplateBinding InputGestureText}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,12,0"
                                          Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                      
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GutterCover" Property="Background" Value="#E2E2E2"/>
                            <!--<Setter TargetName="Bd" Property="Background" Value="#E2E2E2"/>-->
                            <Setter Property="Foreground" Value="#2A2C2B"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="GutterCover" Property="Background" Value="#E2E2E2"/>
                            <!--<Setter TargetName="Bd" Property="Background" Value="#E2E2E2"/>-->
                            <Setter Property="Foreground" Value="#2A2C2B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GutterCover" Property="Background" Value="#1A5EB4"/>
                            <!--<Setter TargetName="Bd" Property="Background" Value="#1A5EB4"/>-->
                            <Setter Property="Foreground" Value="#ffffff"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#858E90"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="ViewMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#2A2C2B"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" 
                            CornerRadius="2"
                           Background="{TemplateBinding Background}" 
                           Height="22"
                            Margin="8,0"
                           MinWidth="200">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                       
                            <ContentPresenter Grid.Column="0" 
                                              ContentSource="Icon" 
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              x:Name="itemicon"
                                              Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" 
                    ContentSource="Header" 
                    VerticalAlignment="Center"
                    Margin="4,0"
                    RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="2" 
             Text="{TemplateBinding InputGestureText}" 
             VerticalAlignment="Center" 
             Margin="8,0,12,0"
             Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E2E2E2"/>
                            <Setter Property="Foreground" Value="#2A2C2B"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E2E2E2"/>
                            <Setter Property="Foreground" Value="#2A2C2B"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="itemicon" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="itemicon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A5EB4"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#858E90"/>
                            <!-- show disabled icon when item is disabled -->
                            <Setter TargetName="itemicon" Property="Content">
                                <Setter.Value>
                                    <Image Source="/Resource/image/10-0.png" Width="16" Height="16" Stretch="Uniform"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="itemicon" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    
    <Style x:Key="TopLevelMenuItemStyle" TargetType="MenuItem">
        <Setter Property="VerticalContentAlignment"  Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="1,3"/>
        <Setter Property="Padding" Value="12,2"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource MainWindowMenuItemStyle}"/>
        <Setter Property="Background" Value="{StaticResource ToolbarBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <!-- 顶部菜单标题 -->
                        <Border x:Name="TopLevelBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <!-- 弹出框：去掉默认 gutter 分隔线 -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               Focusable="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#f5f5f5"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="0,4">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TopLevelBorder" Property="Background" Value="#E2E2E2"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="TopLevelBorder" Property="Background" Value="#E2E2E2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Tab Button Style -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TabInactiveBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3,3,0,0"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Content}" 
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Text=" ×" Foreground="{StaticResource DimTextBrush}" 
                                       VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#C8D8EC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active Tab Style -->
    <Style x:Key="ActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
        <Setter Property="Background" Value="{StaticResource TabActiveBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Toolbar Icon Button -->
    <Style x:Key="ToolIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="4"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#D8EAFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#B8D4F8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PressableIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Image x:Name="icon"
                           Width="24"
                           Height="24"
                           Source="/Resource/image/center0.png"
                           Stretch="Fill"
                           VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 按下时切换图片 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="icon" Property="Source" Value="/Resource/image/center1.png"/>
                        </Trigger>
                        <!-- 松开后自动恢复为 center.png（因为触发器恢复原值） -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Action Button Style (复制套用/套用) -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1A5EB4"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" 
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#5F97CF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#042969"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#525B5D"/>
                            <Setter Property="Background" Value="#C9CFCF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="116"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="#D1DDEA"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#1A5EB4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="board" Background="{TemplateBinding Background}" 
                          CornerRadius="4"
                            BorderBrush="#0048A3"
                            BorderThickness="1"
                          Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" 
                                 Foreground="{TemplateBinding Foreground}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#5F97CF"/>
                            <Setter Property="Background" Value="#D1DDEA"/>
                            <Setter TargetName="board" Property="BorderBrush" Value="#5F97CF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#042969"/>
                            <Setter Property="Background" Value="#D1DDEA"/>
                            <Setter TargetName="board" Property="BorderBrush" Value="#042969"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#525B5D"/>
                            <Setter Property="Background" Value="#C9CFCF"/>
                            <Setter TargetName="board" Property="BorderBrush" Value="#A4AAAC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Layer Item Style -->
    <Style x:Key="LayerItemStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Property Tab Button -->
    <Style x:Key="PropTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActivePropTabButtonStyle" TargetType="Button" BasedOn="{StaticResource PropTabButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 标题文本样式 -->
    <Style x:Key="HeaderLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#777"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style x:Key="MainHeaderLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#2a2c2b"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style x:Key="DrRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="#2A2C2B"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <Grid Width="16" Height="16" Margin="0,0,4,0">
                            <!-- 外框 -->
                            <Border x:Name="OuterBorder"
                             Width="16" Height="16"
                             CornerRadius="9"
                             Background="#ffffff"
                             BorderBrush="#33000000"
                         
                             BorderThickness="1"
                             SnapsToDevicePixels="True">

                            </Border>
                            <!-- 选中指示器 -->
                            <Ellipse x:Name="CheckedIndicator"
                              Width="6" Height="6"
                              Fill="#ffffff"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              SnapsToDevicePixels="True"/>
                        </Grid>
                        <!-- Content 文本 -->
                        <ContentPresenter x:Name="ContentPresenter"
           Content="{TemplateBinding Content}"
           ContentTemplate="{TemplateBinding ContentTemplate}"
           VerticalAlignment="Center"
           TextBlock.FontSize="{TemplateBinding FontSize}"
           TextBlock.Foreground="{TemplateBinding Foreground}"
           RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>



                        <!-- 选中+可用状态 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#0048a3"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#A4AAAC"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#A4AAAC"/>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#A4AAAC"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#F0F0F0"/>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#33000000"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#ffffff"/>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#0048a3"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0048a3"/>

                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#ffffff"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0048a3"/>

                        </MultiTrigger>

                        <!-- 悬停 -->
                        <!--<Trigger Property="IsMouseOver" Value="True">
                         <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0048a3"/>
                         <Setter TargetName="OuterBorder" Property="Background" Value="#ffffff"/>

                     </Trigger>-->

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DrCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#2A2C2B"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <!-- 复选框图标区域 -->
                        <Grid Width="16" Height="16" Margin="0,0,4,0">
                            <!-- 外框 -->
                            <Border x:Name="OuterBorder"
                            Width="16" Height="16"
                            CornerRadius="4"
                            Background="#ffffff"
                            BorderBrush="#33000000"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                            </Border>

                            <!-- 选中指示器（对勾图标） -->
                            <Image
                            Stretch="UniformToFill"
                            Width="16" Height="16"
                            Source="/Resource/image/gou1-2.png"
                            x:Name="CheckedIndicator"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"/>

                            <!-- 部分选择指示器（横线） -->
                            <Rectangle
                            x:Name="IndeterminateIndicator"
                            Width="8" Height="2"
                            Fill="#ffffff"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            RadiusX="1" RadiusY="1"/>
                        </Grid>
                        <!-- Content 文本 -->
                        <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"
                                      TextBlock.FontSize="{TemplateBinding FontSize}"
                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                      RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>

                        <!-- 不确定 + 可用状态（部分选择） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsThreeState" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <!-- 注意：需要配合代码设置 IsChecked = null 来触发不确定状态 -->
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#0048a3"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0048a3"/>
                        </MultiTrigger>

                        <!-- 不确定 + 不可用状态 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsThreeState" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndeterminateIndicator" Property="Fill" Value="#A4AAAC"/>
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#dbdbdb"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#A4AAAC"/>
                        </MultiTrigger>

                        <!-- 选中 + 可用状态 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#0048a3"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0048a3"/>
                        </MultiTrigger>

                        <!-- 选中 + 不可用状态 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Source" Value="/Resource/image/gou2.png"/>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#A4AAAC"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#dbdbdb"/>
                        </MultiTrigger>

                        <!-- 未选中 + 不可用状态 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsThreeState" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#A4AAAC"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#dbdbdb"/>
                        </MultiTrigger>

                        <!-- 未选中 + 可用状态 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsThreeState" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#33000000"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#ffffff"/>
                        </MultiTrigger>

                        <!-- 选中 + 鼠标悬停 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#0048a3"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0048a3"/>
                        </MultiTrigger>

                        <!-- 未选中 + 鼠标悬停 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsThreeState" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckedIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#ffffff"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0048a3"/>
                        </MultiTrigger>

                        <!-- 不确定 + 鼠标悬停 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsThreeState" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="Background" Value="#0048a3"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0048a3"/>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DrComboxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsEditable" Value="False"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <!-- 禁用 WPF 默认验证红框 -->
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border
                      x:Name="border"
                          Background="#FFFFFF"
                          BorderThickness="1"
                          CornerRadius="4"
                            Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          BorderBrush="#D9D9D9">

                            <Grid   >
                                <!-- 内阴影模拟层：从左上到右下的半透明黑色渐变，模拟 inset shadow -->
                                <Border x:Name="shadowLayer"
                          CornerRadius="4"
                          Opacity="1"
                          IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,2">
                                            <GradientStop Color="#33000000"  Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.08"/>
                                        </LinearGradientBrush>

                                    </Border.Background>
                                </Border>

                                <Border x:Name="shadowLayer1"
                         CornerRadius="4"
                         Opacity="1"
                         IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,0">
                                            <GradientStop Color="#33000000"  Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.08"/>
                                        </LinearGradientBrush>

                                    </Border.Background>
                                </Border>


                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 内容显示区域 -->
                                    <ContentPresenter x:Name="ContentSite"
                                            Grid.Column="0"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            TextBlock.Foreground="{TemplateBinding Foreground}"
                                            IsHitTestVisible="False"/>

                                    <!-- 下拉箭头按钮 -->
                                    <ToggleButton x:Name="DropDownToggle"
                                        Grid.Column="1"
                                        Width="20"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Image 
                                              x:Name="Arrow" 
                                              Source="/Resource/image/CBdown.png"   
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"    
                                              Width="22"
                                              Height="22"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Source" Value="/Resource/image/CBdownS.png"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Arrow" Property="Source" Value="/Resource/image/CBdownS.png"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 下拉列表弹出层 -->

                        <Popup x:Name="Popup"  
                                     VerticalOffset="2"
                            Placement="Bottom"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            AllowsTransparency="True"
                            Focusable="False" 
                            PopupAnimation="Slide" >
                            <Border Background="White" Margin="4,1,4,4" CornerRadius="4"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                <!--外阴影1.Effect；2.需要留出Margin；-->
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="3" Color="#000000" BlurRadius="5" Direction="315" Opacity="0.5" />
                                </Border.Effect>

                                <ScrollViewer x:Name="ScrollViewer" MaxHeight="200" Margin="4">
                                    <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>

                            </Border>

                        </Popup>


                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#858E90"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="#D9D9D9"/>
                            <Setter TargetName="border" Property="Background" Value="#E2E2E2"/>
                            <Setter TargetName="shadowLayer" Property="Opacity" Value="1"/>
                            <Setter TargetName="shadowLayer1" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- 下拉列表项样式 -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="Padding" Value="8,2"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Background" Value="#ffffff"/>
                    <Setter Property="Foreground" Value="#2A2C2B"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="2"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalAlignment="Stretch">
                                    <ContentPresenter
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         TextBlock.FontSize="{TemplateBinding FontSize}"
                                         TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EDEEEF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#DDE7F4"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True"/>
                                            <Condition Property="IsHighlighted" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="#DDE7F4"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="InputBoxStyle" TargetType="TextBox">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="24"/>

    </Style>

    <Style x:Key="SeconedInputBoxStyle" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="88"/>
        <Setter Property="Height" Value="24"/>

    </Style>
    <!-- TabControl 整体样式 -->
    <Style x:Key="DrTabControlStyle" TargetType="TabControl">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel Background="#E2E2E2" Margin="4">
                        <!-- 标签栏区域 -->
                        <Border DockPanel.Dock="Top">
                            <WrapPanel x:Name="HeaderPanel"
                                       IsItemsHost="True"
                                       Panel.ZIndex="1"
                                       Margin="0,0,0,0"/>
                        </Border>
                        <!-- 内容区域 -->
                        <Border x:Name="ContentPanel">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabItem 下划线式样式 -->
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#2A2C2B"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root">
                        <Border x:Name="BottomLine" 
                              BorderThickness="0,0,0,2" 
                              BorderBrush="Transparent"
                              Padding="{TemplateBinding Padding}"
                              SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"
                                              Margin="2,0"
                                              TextBlock.TextAlignment="Center"
                                            TextBlock.FontSize="{TemplateBinding FontSize}"
                                            TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 选中状态 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BottomLine" Property="BorderBrush" Value="#1A5EB4"/>
                            <Setter Property="Foreground" Value="#1A5EB4"/>
                        </Trigger>
                        <!-- 鼠标悬停（未选中时） -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="#555555"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TitleRight" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>
 
    <Style x:Key="IOBoard" TargetType="Border">
        <Setter Property="BorderBrush" Value="#e2e2e2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,0,8,8"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Background" Value="#FAFAFA"/>
    </Style>

    <Style x:Key="IOBoardGray" TargetType="Border">
        <Setter Property="BorderBrush" Value="#D9D9D9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Background" Value="#E2E2E2"/>
    </Style>
    
 
</ResourceDictionary>
