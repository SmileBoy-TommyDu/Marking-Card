<Application x:Class="DrSoft.MarkCard.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DrSoft.MarkCard.UI"
             xmlns:conv="clr-namespace:DrSoft.MarkCard.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
                <ResourceDictionary Source="Themes/Generic.xaml"/>
                <ResourceDictionary Source="Views/Config/ConfigViews.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBooleanConverter x:Key="InverseBoolConverter"/>
            <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" IsInverse="True"/>

            <!-- 通用标签样式 -->
            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Foreground" Value="#2A2C2B"/>
            </Style>

            <!-- 通用单位样式 -->
            <Style x:Key="UnitText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="Gray"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
            </Style>

            <!-- 通用数字输入框样式 -->
            <Style x:Key="NumericInput" TargetType="TextBox">
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="#EAEAEA"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="5,0,20,0"/>
            </Style>

            <Style x:Key="ImageRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" BorderBrush="#888" BorderThickness="2" Padding="10" Background="White">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 选中状态：边框变黑并加粗，模拟按下效果 -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="4"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <!-- 鼠标悬停 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#F9F9F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ApplyButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="5" />
            </Style>
        </ResourceDictionary>

        
        
    </Application.Resources>
</Application>
