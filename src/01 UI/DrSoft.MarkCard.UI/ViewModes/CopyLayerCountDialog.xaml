<Window x:Class="DrSoft.MarkCard.UI.ViewModes.CopyLayerCountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="复制图层"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBox x:Name="CountInput" Text="1" Margin="0,0,0,16"
                 VerticalContentAlignment="Center" Height="28" FontSize="14"
                 PreviewTextInput="CountInput_PreviewTextInput"
                 DataObject.Pasting="CountInput_Pasting"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="OkButton_Click"/>
            <Button Content="取消" Width="80" Height="28" IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
