<Window x:Class="DrawingControlsDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrawingControlsDemo"
        mc:Ignorable="d"
        Title="绘图控件测试" Height="900" Width="1400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="713*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 绘图工具栏 -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Label Content="绘图工具:" Margin="0,0,5,0" FontWeight="Bold"/>
            <Button Content="选择" Click="SelectTool_Click" Tag="Select" Width="60"/>
            <Button Content="点" Click="DrawingTool_Click" Tag="Dot" Width="50"/>
            <Button Content="直线" Click="DrawingTool_Click" Tag="Line" Width="50"/>
            <Button Content="矩形" Click="DrawingTool_Click" Tag="Rectangle" Width="50"/>
            <Button Content="圆形" Click="DrawingTool_Click" Tag="Circle" Width="50"/>
            <Button Content="多边形" Click="DrawingTool_Click" Tag="Polygon" Width="60"/>
            <Button Content="圆弧" Click="DrawingTool_Click" Tag="Arc" Width="50"/>
            <Button Content="贝塞尔" Click="DrawingTool_Click" Tag="Bezier" Width="60"/>
            <Button Content="文字" Click="DrawingTool_Click" Tag="Text" Width="50"/>

            <Separator/>

            <Label Content="操作:" Margin="0,0,5,0" FontWeight="Bold"/>
            <Button Content="删除" Click="Delete_Click" Width="50"/>
            <Button Content="复制" Click="Copy_Click" Width="50"/>
            <Button Content="粘贴" Click="Paste_Click" Width="50"/>
            <Separator/>
            <Button Content="水平镜像" Click="MirrorHorizontal_Click" Width="70"/>
            <Button Content="垂直镜像" Click="MirrorVertical_Click" Width="70"/>

            <Separator/>

            <Label Content="视图:" Margin="0,0,5,0" FontWeight="Bold"/>
            <Button Content="撤销" Click="Undo_Click" Width="50"/>
            <Button Content="重做" Click="Redo_Click" Width="50"/>
            <Button Content="平移" Click="Pan_Click" Width="50"/>
            <Button Content="放大" Click="ZoomIn_Click" Width="50"/>
            <Button Content="缩小" Click="ZoomOut_Click" Width="50"/>
            <Button Content="重置视图" Click="ResetView_Click" Width="70"/>
            <Button Content="适应窗口" Click="ZoomToFit_Click" Width="70"/>

            <Separator/>

            <Label Content="文件:" Margin="0,0,5,0" FontWeight="Bold"/>
            <Button Content="新建" Click="NewCanvas_Click" Width="50"/>
            <Button Content="导入" Click="ImportDxf_Click" Width="50"/>
            <Button Content="导出" Click="ExportDxf_Click" Width="50"/>
        </ToolBar>

        <!-- 文字工具栏 -->
        <ToolBar ToolBarTray.IsLocked="True" Margin="0,30,0,0" Grid.RowSpan="2">
            <Label Content="文字样式:" Margin="0,0,5,0" FontWeight="Bold"/>
            <TextBlock Text="字体:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="FontFamilyCombo" Width="120" SelectionChanged="FontFamily_SelectionChanged">
                <ComboBoxItem Content="微软雅黑" IsSelected="True"/>
                <ComboBoxItem Content="宋体"/>
                <ComboBoxItem Content="黑体"/>
                <ComboBoxItem Content="楷体"/>
                <ComboBoxItem Content="Arial"/>
                <ComboBoxItem Content="Times New Roman"/>
            </ComboBox>

            <TextBlock Text="字号:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <ComboBox x:Name="FontSizeCombo" Width="60" SelectionChanged="FontSize_SelectionChanged">
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="12" IsSelected="True"/>
                <ComboBoxItem Content="14"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="24"/>
                <ComboBoxItem Content="28"/>
                <ComboBoxItem Content="32"/>
                <ComboBoxItem Content="36"/>
                <ComboBoxItem Content="48"/>
                <ComboBoxItem Content="72"/>
            </ComboBox>

            <Separator/>

            <CheckBox x:Name="BoldCheckBox" Content="粗体" Margin="5,0" Click="Bold_Click"/>
            <CheckBox x:Name="ItalicCheckBox" Content="斜体" Margin="5,0" Click="Italic_Click"/>
            <CheckBox x:Name="UnderlineCheckBox" Content="下划线" Margin="5,0" Click="Underline_Click"/>

            <Separator/>

            <TextBlock Text="对齐:" VerticalAlignment="Center" Margin="5,0"/>
            <Button Content="左对齐" Click="AlignLeft_Click" Width="50"/>
            <Button Content="居中" Click="AlignCenter_Click" Width="50"/>
            <Button Content="右对齐" Click="AlignRight_Click" Width="50"/>

            <Separator/>

            <TextBlock Text="行距:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="LineHeightCombo" Width="60" SelectionChanged="LineHeight_SelectionChanged">
                <ComboBoxItem Content="1.0"/>
                <ComboBoxItem Content="1.2" IsSelected="True"/>
                <ComboBoxItem Content="1.5"/>
                <ComboBoxItem Content="2.0"/>
                <ComboBoxItem Content="2.5"/>
                <ComboBoxItem Content="3.0"/>
            </ComboBox>

            <TextBlock Text="字距:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <ComboBox x:Name="CharSpacingCombo" Width="60" SelectionChanged="CharSpacing_SelectionChanged">
                <ComboBoxItem Content="0" IsSelected="True"/>
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="8"/>
            </ComboBox>

            <Separator/>

            <Button Content="更新文字" Click="UpdateTextFont_Click" Width="70"/>
        </ToolBar>

        <!-- 绘图内容区 -->
        <Grid x:Name="CanvasContainer" Grid.Row="1" Margin="0,30,0,21" Grid.RowSpan="4"/>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪 - 选择工具开始绘制"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="100%"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>