<UserControl x:Class="DrSoft.MarkCard.CommonUI.UserControls.NumericInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="200"
           x:Name="Root">
    <StackPanel Orientation="Horizontal" Grid.Column="2">
        <TextBox Width="{Binding InputWidth, ElementName=Root}" Height="28" x:Name="numericText" VerticalContentAlignment="Center"/>
        <TextBlock  Margin="-48 -2 6 0" x:Name="unitText" VerticalAlignment="Center"  HorizontalAlignment="Right" />
    </StackPanel>
</UserControl>
