<UserControl x:Class="DrSoft.MarkCard.CommonUI.UserControls.NumericUpDownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="24"
             d:DesignWidth="120"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary Source="/DrSoft.MarkCard.CommonUI;component/Style.xaml"/>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border x:Name="RootBorder"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="4"
                Height="24">
            <Grid >
                <uc:NumberDataExpressionTextBox x:Name="ValueTextBox"   
                                             Width="{Binding Width, ElementName=Root}"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Left"
                         Title="{Binding Title, ElementName=Root}"
                         Unit="{Binding Unit, ElementName=Root}"
                         DecimalPlaces="{Binding DecimalPlaces, ElementName=Root}"
                         MinValue="{Binding MinValue, ElementName=Root}"
                         MaxValue="{Binding MaxValue, ElementName=Root}"
                         ShowToolTip="{Binding ShowToolTip, ElementName=Root}"
                         PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                         LostFocus="ValueTextBox_LostFocus"
                         GotFocus="ValueTextBox_GotFocus"/>

                <Grid  HorizontalAlignment="Right" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <RepeatButton x:Name="UpButton"
                                  Grid.Row="0"
                                  Background="Transparent"
                                  Delay="300"
                                  Interval="50"
                                  Click="UpButton_Click"
                                  Visibility="Collapsed">
                        <RepeatButton.Style>
                            <Style TargetType="RepeatButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">

                                            <Image x:Name="Arrow" 
                                                       Source="pack://application:,,,/DrSoft.MarkCard.CommonUI;component/Resource/image/up2x.png"  
                                                       HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Stretch="Uniform"
                                                       Width="22"
                                                       Height="11"/>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Source" Value="pack://application:,,,/DrSoft.MarkCard.CommonUI;component/Resource/image/up2x.png"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Arrow" Property="Source" Value="pack://application:,,,/DrSoft.MarkCard.CommonUI;component/Resource/image/up2xs.png"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Arrow" Property="Source" Value="pack://application:,,,/DrSoft.MarkCard.CommonUI;component/Resource/image/up2x.png"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RepeatButton.Style>
                    </RepeatButton>

                    <RepeatButton x:Name="DownButton"
                                  Grid.Row="1"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Delay="300"
                                  Interval="50"
                                  Click="DownButton_Click"
                                  Visibility="Collapsed">
                        <RepeatButton.Style>
                            <Style TargetType="RepeatButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">

                                            <Image x:Name="Arrow"
                                                    Source="pack://application:,,,/DrSoft.MarkCard.CommonUI;component/Resource/image/down2x.png"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                       Width="22"
                                                       Height="11"/>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Source" Value="pack://application:,,,/DrSoft.MarkCard.CommonUI;component/Resource/image/down2xs.png"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Arrow" Property="Source" Value="pack://application:,,,/DrSoft.MarkCard.CommonUI;component/Resource/image/down2xs.png"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Arrow" Property="Source" Value="pack://application:,,,/DrSoft.MarkCard.CommonUI;component/Resource/image/down2x.png"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RepeatButton.Style>
                    </RepeatButton>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
