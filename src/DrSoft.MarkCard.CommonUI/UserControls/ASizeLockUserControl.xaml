<UserControl x:Class="DrSoft.MarkCard.CommonUI.UserControls.ASizeLockUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
                 xmlns:local="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls" 
         x:Name="root"
         d:DesignHeight="100" 
         d:DesignWidth="300">



    <Grid Margin="5"   >
        <!-- 标题行 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,5">
            <TextBlock Text="{Binding Title, ElementName=root}" FontSize="14" />
            <TextBlock Text="{Binding Unit, ElementName=root}" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- 输入框行 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 宽度标签 + 输入框 -->
            <TextBlock Grid.Column="0" Text="{Binding WidthLabel, ElementName=root}" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <local:NumericUpDownControl 
            HorizontalAlignment="Left"
           Grid.Column="1" 
           x:Name="wText"
           Tag="Width"
            
  MinValue="0"
           Title="" 
            Unit=""
           Value="{Binding WidthValue, ElementName=root, UpdateSourceTrigger=LostFocus}"
           CommittedCommand="{Binding WidthCommittedCommand, ElementName=root}"
         Style="{StaticResource MainNumericUpDown}"
           VerticalAlignment="Center"/>



            <!-- 锁按钮 -->
            <ToggleButton 
            Grid.Row="0" 
            Grid.Column="2" 
            Grid.RowSpan="2"
                 Margin="4,10"
                     ToolTip="锁定宽高比：开启后宽度和高度按原比例联动调整"
                     IsChecked="{Binding IsLocked, ElementName=root, Mode=TwoWay}" 
                     IsEnabled="{Binding IsLockToggleEnabled, ElementName=root}"
                     Width="24" 
                     Height="24" 
                     BorderBrush="Transparent"
                     BorderThickness="0"
                     Background="Transparent" 
                     Click="LockButton_Click">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="4">
                                        <Grid >
                                            <!-- 开锁图标（默认显示） -->
                                            <Image 
                                           Width="14"
                                           Height="14"
                                           x:Name="imgUnlock" 
                                           Source="/Resource/image/unlock.png" 
                                          Visibility="Visible" />
                                            <!-- 闭锁图标（默认隐藏） -->
                                            <Image 
                                           x:Name="imgLock"
                                           Source="/Resource/image/lock.png" 
                                          Visibility="Collapsed" 
                                           Width="14"
                                           Height="14"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 锁定状态（IsChecked=True）时，显示闭锁图标 -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="imgLock" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="imgUnlock" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <!-- 高度标签 + 输入框 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding HeightLabel, ElementName=root}" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <local:NumericUpDownControl    
            HorizontalAlignment="Left"
            Grid.Row="1" 
           Grid.Column="1" 
           x:Name="hText"
           Tag="Height"
           Style="{StaticResource  MainNumericUpDown}"
            
          MinValue="0"
           Title="" 
           Unit=""
           Value="{Binding HeightValue, ElementName=root, UpdateSourceTrigger=LostFocus}" 
           CommittedCommand="{Binding HeightCommittedCommand, ElementName=root}"
           VerticalAlignment="Center"/>


        </Grid>
    </Grid>
</UserControl>
