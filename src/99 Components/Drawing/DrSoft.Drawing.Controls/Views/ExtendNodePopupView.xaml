<UserControl x:Class="DrSoft.Drawing.Controls.Views.ExtendNodePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:DrSoft.Drawing.Controls.ViewModels"
             xmlns:uc1="clr-namespace:DrSoft.MarkCard.CommonUI.UserControls;assembly=DrSoft.MarkCard.CommonUI"
             d:DataContext="{d:DesignInstance Type=viewmodels:ExtendNodePopupViewModel}"
             mc:Ignorable="d"
             Height="150"
             Width="340">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0"
                  Content="相对前一点"
                  IsChecked="{Binding IsRelativeToPrevious}" />

        <GroupBox Grid.Row="2"
                  Header="坐标位置">
            <Grid Margin="12,10,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="X："
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <uc1:NumericUpDownControl Grid.Row="0"
                                          Grid.Column="2"
                                          Width="100"
                                          Unit="mm"
                                          Value="{Binding InputX, StringFormat=F3}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Y："
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <uc1:NumericUpDownControl Grid.Row="2"
                                          Grid.Column="2"
                                          Width="100"
                                          Unit="mm"
                                          Value="{Binding InputY, StringFormat=F3}" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
