<Window x:Class="DrSoft.Drawing.Controls.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Width="360"
        MinWidth="360"
       Height="{Binding WindowHeight,ElementName=Root}"
        WindowStartupLocation="CenterOwner"
         AllowsTransparency="True"
        WindowStyle="None"
       Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border  Margin="20" >
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0"  Color="#000" Opacity="0.3"/>
        </Border.Effect>
        <Border  CornerRadius="6"
            BorderBrush="#CCCCCC" BorderThickness="1"
            Background="#F5F5F5">
            <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Background="#e2e2e2"
                    CornerRadius="5,5,0,0">
                <Grid Height="32" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#3e4446"/>
                    <Button Grid.Column="1"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            Click="CloseButton_Click"
                            Cursor="Hand"
                            Width="28" Height="28"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#3e4446"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E8E8E8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 中间内容区域：动态注入自定义 View -->
            <ContentControl Grid.Row="1"
                            Content="{Binding Content}"
                            Margin="0"
                           
                            VerticalContentAlignment="Top"
                            HorizontalContentAlignment="Stretch"/>

            <!-- 按钮区域 -->
            <Border Grid.Row="2" >
                <Grid  HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="{Binding ConfirmText}" 
                            Command="{Binding ConfirmCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Width="74"  Margin="0,8,0,8"/>
                        <Button Grid.Column="2" Content="{Binding CancelText}" 
                            Command="{Binding CancelCommand}"
                            Width="74" 
                            Margin="4,8,8,8"
                            Style="{StaticResource SecondActionButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Border>
</Window>
