<UserControl x:Class="DrSoft.Drawing.Controls.DrawingCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:local="clr-namespace:DrSoft.Drawing.Controls.Converters"
             xmlns:userControls="clr-namespace:DrSoft.Drawing.Controls.UserControl"
             xmlns:local1="clr-namespace:DrSoft.Drawing.Controls.Menu"
             xmlns:local2="clr-namespace:DrSoft.Drawing.Controls.ViewModels"
             Focusable="True">
    <UserControl.Resources>
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="ToolButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ToolTipService.ShowDuration" Value="3000"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CanvasTabIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StateButtonStyle" TargetType="userControls:StateButton">
            <!-- 基础属性 -->
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IconWidth" Value="24"/>
            <Setter Property="IconHeight" Value="24"/>
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="BorderBrush" Value="#5F97CF"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="userControls:StateButton">
                        <!-- 外层 Border：开启裁剪，防止内阴影模糊溢出 -->
                        <Border x:Name="PART_Root"                       
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        ClipToBounds="True">
                            <!-- 关键：裁剪溢出内容 -->

                            <Grid>
                                <Border x:Name="InnerShadowBorderX"
                                    CornerRadius="4"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="2,0">
                                            <GradientStop Color="#33000000"  Offset="0"/>
                                            <!--<GradientStop Color="#80FF0000" Offset="0.05"/>-->
                                            <GradientStop Color="#00000000" Offset="0.08"/>
                                        </LinearGradientBrush>

                                    </Border.Background>
                                </Border>

                                <Border x:Name="InnerShadowBorderY"
                                    CornerRadius="4"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,2">
                                            <GradientStop Color="#33000000"  Offset="0"/>
                                            <!--<GradientStop Color="#80FF0000" Offset="0.05"/>-->
                                            <GradientStop Color="#00000000" Offset="0.08"/>
                                        </LinearGradientBrush>

                                    </Border.Background>
                                </Border>

                                <Grid>
                                    <!-- 正常图标 -->
                                    <Image x:Name="PART_NormalIcon"
                                        Source="{TemplateBinding NormalIcon}"
                                        Width="{TemplateBinding IconWidth}"
                                        Height="{TemplateBinding IconHeight}"
                                        Stretch="Uniform"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                    <!-- 禁用图标 -->
                                    <Image x:Name="PART_DisabledIcon"
                                        Source="{TemplateBinding DisabledIcon}"
                                        Width="{TemplateBinding IconWidth}"
                                        Height="{TemplateBinding IconHeight}"
                                        Stretch="Uniform"
                                        Margin="{TemplateBinding Padding}"
                                        Opacity="0.4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>

                                    <Image x:Name="PART_DragDownIcon"
                                        Source="{TemplateBinding DragDownIcon}"
                                        Width="6"
                                        Height="6"
                                        Stretch="Uniform"
                                        Margin="{TemplateBinding Padding}"
                                        Opacity="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Visibility="Collapsed"/>

                                    <!-- 文本内容 -->
                                    <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 有内容时：隐藏图标，显示文本 -->
                            <Trigger Property="HasContent" Value="True">
                                <Setter TargetName="PART_NormalIcon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_DisabledIcon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ContentPresenter" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsDragDown" Value="True">
                                <Setter TargetName="PART_DragDownIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Root" Property="BorderBrush" Value="#D9D9D9"/>
                                <Setter TargetName="PART_Root" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="InnerShadowBorderX" Property="Opacity" Value="1"/>
                                <Setter TargetName="InnerShadowBorderY" Property="Opacity" Value="1"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PART_Root" Property="BorderBrush" Value="#1A5EB4"/>
                                <Setter TargetName="PART_Root" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="InnerShadowBorderX" Property="Opacity" Value="1"/>
                                <Setter TargetName="InnerShadowBorderY" Property="Opacity" Value="1"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 基础画刷 -->
        <SolidColorBrush x:Key="MenuBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ItemHover" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="ItemText" Color="#1F2937"/>
        <SolidColorBrush x:Key="SubmenuBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SeparatorColor" Color="#E5E7EB"/>

        <!-- Menu 样式 -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource MenuBg}"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="思源黑体 CN"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Menu">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色磨砂玻璃风格菜单样式 (与之前一致) -->
        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#DDE7F4" />
        <SolidColorBrush x:Key="FatherMenuItemHoverBrush" Color="#EDEEEF" />
        <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#E2E2E2" />
        <SolidColorBrush x:Key="MenuTextBrush" Color="#2A2C2B" />
        <SolidColorBrush x:Key="SubMenuHeaderBrush" Color="#B9C3D0" />

        <DropShadowEffect x:Key="MenuShadow" Color="#000000" Opacity="0.35" BlurRadius="15" ShadowDepth="3" Direction="-90"/>

        <!-- MenuItem 样式（完整支持子菜单弹出、快捷键、右箭头） -->
        <Style x:Key="CanvasMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="222"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}"/>
            <Setter Property="FontFamily" Value="思源黑体 CN"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        Margin="2,0,2,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 菜单标题（支持下划线快捷键） -->
                                <ContentPresenter x:Name="HeaderHost"
                                          Grid.Column="0"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          Margin="5 0 5 0"
                                          RecognizesAccessKey="True"/>

                                <!-- 快捷键文本 -->
                                <TextBlock x:Name="InputGestureTextBlock"
                                   Grid.Column="1"
                                   Text="{TemplateBinding InputGestureText}"
                                   VerticalAlignment="Center"
                                   Margin="5 0 5 0"
                                   Foreground="{StaticResource MenuTextBrush}"
                                   FontSize="14"/>

                                <!-- 子菜单右箭头 -->
                                <Path x:Name="SubMenuArrow"
                                        Grid.Column="2"
                                        Data="M 0 0 L 4 4 L 0 8 Z"
                                        Fill="{StaticResource MenuTextBrush}"
                                        Width="6"
                                        Height="10"
                                        Stretch="Fill"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"/>

                                <!-- 子菜单弹出区域（关键！缺少此项子菜单无法弹出） -->
                                <Popup x:Name="PART_Popup"
                                    Grid.ColumnSpan="3"
                                    AllowsTransparency="True"
                                    Opened="ContextSubMenuPopup_Opened"  
                                    IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                    HorizontalOffset="220"
                                    VerticalOffset="-20"
                                    Placement="Right"
                                    PopupAnimation="Fade">
                                    <Border Background="{StaticResource MenuBackgroundBrush}"
                                        BorderBrush="#4A4F5E"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6,4"
                                        Effect="{StaticResource MenuShadow}">
                                        <ItemsPresenter/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 多条件触发器：同时满足 HasItems==true 和 IsHighlighted==true，鼠标悬停且有子菜单 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="HasItems" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource FatherMenuItemHoverBrush}"/>
                            </MultiTrigger>
                            <!-- 多条件触发器：同时满足 HasItems==true 和 IsHighlighted==false，鼠标未悬停且有子菜单 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="HasItems" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource MenuBackgroundBrush}"/>
                            </MultiTrigger>
                            <!-- 多条件触发器：同时满足 HasItems==false 和 IsHighlighted==true，鼠标悬停且没有子菜单 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="HasItems" Value="False"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource MenuItemHoverBrush}"/>
                            </MultiTrigger>
                            <!-- 有子菜单时显示右箭头 -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- 鼠标悬停高亮 -->
                            <!--<Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource MenuItemHoverBrush}"/>
                            </Trigger>-->
                            <!-- 禁用状态 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6C727E"/>
                            </Trigger>
                            <!-- 顶级菜单项（如果作为顶级菜单，子菜单放在下方） -->
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- 子菜单项的统一样式（确保快捷键和悬停效果一致） -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="MenuItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource MenuTextBrush}"/>
                        <Setter Property="Padding" Value="10,6,12,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,16,0"
                                                      RecognizesAccessKey="True"/>
                                            <TextBlock Grid.Column="1"
                                               Text="{TemplateBinding InputGestureText}"
                                               Margin="24,0,12,0"
                                               Foreground="{StaticResource MenuTextBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="{StaticResource MenuItemHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!--分隔符样式-->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4,8,4"/>
            <Setter Property="Background" Value="{StaticResource SeparatorColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模板选择器：根据 IsSeparator 决定渲染分隔符还是普通菜单项 -->
        <local2:MenuItemTemplateSelector x:Key="MenuItemTemplateSelector">
            <local2:MenuItemTemplateSelector.NormalTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </local2:MenuItemTemplateSelector.NormalTemplate>
            <local2:MenuItemTemplateSelector.SeparatorTemplate>
                <DataTemplate>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                </DataTemplate>
            </local2:MenuItemTemplateSelector.SeparatorTemplate>
        </local2:MenuItemTemplateSelector>

        <!-- HierarchicalDataTemplate 用于渲染子菜单 -->
        <HierarchicalDataTemplate DataType="{x:Type local2:MenuItemViewModel}" ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 如果是分隔符，单独显示 -->
                <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource MenuItemTemplateSelector}" />
            </Grid>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <!--<ColumnDefinition Width="300"/>-->
        </Grid.ColumnDefinitions>

        <!-- 左侧工具栏 -->
        <Grid Grid.Column="0">
            <Border Grid.Column="0" Width="44" Background="#FFF5F5F5" 
                BorderBrush="#FFCCCCCC" BorderThickness="0,0,1,0">
                <StackPanel x:Name="ToolPanel" Margin="2">

                    <userControls:StateButton x:Name="ToolSelect" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsSelectEnabled, Mode=OneWay}"
                      IsChecked="{Binding IsSelectActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Select"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/SelectEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/SelectDisable.png"
                      Tag="Select"
                      ToolTip="选择工具 (V)">
                    </userControls:StateButton>

                    <Separator Margin="0,8" Background="#FFCCCCCC"/>

                    <userControls:StateButton x:Name="ToolPoint" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsDotActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Dot"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/PointEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/PointDisable.png"
                      Tag="Dot" 
                      ToolTip="点 (O)">
                    </userControls:StateButton>

                    <Separator Margin="0,8" Background="#FFCCCCCC"/>

                    <userControls:StateButton x:Name="ToolLine" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsLineActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Line"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/LineEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/LineDisable.png"
                      Tag="Line" 
                      ToolTip="直线 (L)">
                    </userControls:StateButton>

                    <userControls:StateButton x:Name="ToolBezier" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsBezierActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Bezier"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/BezierCurveEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/BezierCurveDisable.png"                                              
                      Tag="Bezier" 
                      ToolTip="贝塞尔曲线 (B)">
                    </userControls:StateButton>

                    <userControls:StateButton x:Name="ToolArc" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsArcActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Arc"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/CurveEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/CurveDisable.png"
                      Tag="Arc" 
                      ToolTip="圆弧 (A)">
                    </userControls:StateButton>

                    <userControls:StateButton x:Name="ToolCircle" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsCircleActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Circle"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/CircleEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/CircleDisable.png"                                              
                      Tag="Circle" 
                      ToolTip="圆形 (C)">
                    </userControls:StateButton>

                    <userControls:StateButton x:Name="ToolRectangle" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsRectangleActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Rectangle"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/RectangleEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/RectangleDisable.png"
                      Tag="Rectangle" 
                      ToolTip="矩形 (R)">
                    </userControls:StateButton>

                    <userControls:StateButton x:Name="ToolPolygon" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsPolygonActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Polygon"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/PolygonEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/PolygonDisable.png"                                              
                      Tag="Polygon" 
                      ToolTip="多边形 (P)">
                    </userControls:StateButton>

                    <userControls:StateButton x:Name="ToolArbitraryCurve" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsArbitraryCurveActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="ArbitraryCurve"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ArbitraryCurveEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ArbitraryCurveDisable.png"                                              
                      Tag="ArbitraryCurve" 
                      ToolTip="任意曲线">
                    </userControls:StateButton>

                    <Separator Margin="0,8" Background="#FFCCCCCC"/>

                    <userControls:StateButton x:Name="ToolText" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      IsChecked="{Binding IsTextActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Text"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/TextEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/TextDisable.png"                                              
                      Tag="InputA" 
                      ToolTip="输入文本">
                    </userControls:StateButton>

                    <Separator Margin="0,8" Background="#FFCCCCCC"/>

                    <userControls:StateButton x:Name="ToolZoom" 
                      Style="{StaticResource StateButtonStyle}"
                      Padding="{Binding IconMargin}"
                      IsEnabled="{Binding IsDrawingToolEnabled}"
                      Click="ToolZoom_Click"
                      CommandParameter="Zoom"
                      NormalIcon ="{Binding ZoomToolNormalIcon}"
                      DisabledIcon="{Binding ZoomToolDisabledIcon}" 
                      DragDownIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/DragDown.png"
                      Tag="Zoom" 
                      ToolTip="缩放">
                    </userControls:StateButton>

                    <Separator Margin="0,8" Background="#FFCCCCCC"/>

                    <userControls:StateButton x:Name="ToolMove" 
                      Style="{StaticResource StateButtonStyle}"
                      IsEnabled="{Binding IsMoveEnabled}"
                      IsChecked="{Binding IsMoveActive, Mode=OneWay}"
                      Command="{Binding SelectToolCommand}"
                      CommandParameter="Move"
                      NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/MoveEnable.png"
                      DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/MoveDisable.png"                                              
                      Tag="Move" 
                      ToolTip="移动">
                    </userControls:StateButton>

                    <Separator Margin="0,8" Background="#FFCCCCCC"/>
                </StackPanel>
            </Border>

            <!-- 弹出浮层（Popup）包含三个对齐选项 -->
            <Popup x:Name="ToolZoomPopup" 
               PlacementTarget="{Binding ElementName=ToolZoom}"
               Placement="Right"
               StaysOpen="False"
               HorizontalOffset ="10"
               IsOpen="{Binding IsToolZoomPopupOpen}"
               AllowsTransparency="True">
                <Border Background="White" CornerRadius="6" BorderBrush="#BDC3C7" 
                    BorderThickness="1" Padding="4" >
                    <StackPanel>
                        <userControls:StateButton x:Name="ZoomIn" 
                                                  Style="{StaticResource StateButtonStyle}"  
                                                  IsEnabled="{Binding IsZoomInEnabled}"
                                                  IsChecked="{Binding IsZoomInChecked, Mode=OneWay}"
                                                  Command="{Binding SelectToolCommand}"
                                                  CommandParameter="ZoomIn"
                                                  NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomInEnable.png"
                                                  DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomInDisable.png"                                              
                                                  ToolTip="放大"
                                                  Tag="ZoomIn" />
                        <userControls:StateButton x:Name="ZoomOut" 
                                                  Style="{StaticResource StateButtonStyle}"    
                                                  IsEnabled="{Binding IsZoomOutEnabled}"
                                                  IsChecked="{Binding IsZoomOutChecked, Mode=OneWay}"                                                  
                                                  Command="{Binding SelectToolCommand}"
                                                  CommandParameter="ZoomOut"
                                                  NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomOutEnable.png"
                                                  DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomOutDisable.png"                                              
                                                  ToolTip="缩小"
                                                  Tag="ZoomOut" />
                        <userControls:StateButton x:Name="ZoomBack" 
                                                  Style="{StaticResource StateButtonStyle}"   
                                                  IsEnabled="{Binding IsZoomBackEnabled}"
                                                  IsChecked="{Binding IsZoomBackChecked , Mode=OneWay}"
                                                  Command="{Binding SelectToolCommand}"
                                                  CommandParameter="ZoomBack"
                                                  NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomBackEnable.png"
                                                  DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomBackDisable.png"                                              
                                                  ToolTip="撤销"
                                                  Tag="ZoomBack" />
                        <userControls:StateButton x:Name="ZoomToFullScreen" 
                                                  Style="{StaticResource StateButtonStyle}" 
                                                  IsEnabled="{Binding IsZoomToFullScreenEnabled}"
                                                  IsChecked="{Binding IsZoomToFullScreenChecked, Mode=OneWay}"
                                                  Command="{Binding SelectToolCommand}"
                                                  CommandParameter="ZoomToFullScreen"
                                                  NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomToFullScreenEnable.png"
                                                  DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomToFullScreenDisable.png"                                              
                                                  ToolTip="全屏"
                                                  Tag="ZoomToFullScreen" />
                        <userControls:StateButton x:Name="ZoomToFit" 
                                                  Style="{StaticResource StateButtonStyle}" 
                                                  IsEnabled="{Binding IsZoomToFitEnabled}"
                                                  IsChecked="{Binding IsZoomToFitChecked, Mode=OneWay}"
                                                  Command="{Binding SelectToolCommand}"
                                                  CommandParameter="ZoomToFit"
                                                  NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomToFitEnable.png"
                                                  DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomToFitDisable.png"                                              
                                                  ToolTip="适合屏幕"
                                                  Tag="ZoomToFit" />
                        <userControls:StateButton x:Name="ZoomToSelection" 
                                                  Style="{StaticResource StateButtonStyle}"  
                                                  IsEnabled="{Binding IsZoomToSelectionEnabled}"
                                                  IsChecked="{Binding IsZoomToSelectionChecked, Mode=OneWay}"
                                                  Command="{Binding SelectToolCommand}"
                                                  CommandParameter="ZoomToSelection"
                                                  NormalIcon ="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomToSelectionEnable.png"
                                                  DisabledIcon="/DrSoft.Drawing.Controls;component/Resources/image/drawingToolIcon/ZoomToSelectionDisable.png"                                              
                                                  ToolTip="放大选中"
                                                  Tag="ZoomToSelection" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- 画布区域 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFFFF" x:Name="CanvasBorder" 
                        ClipToBounds="True" Margin="2">
                <Grid>
                    <skia:SKElement x:Name="SkiaCanvas" PaintSurface="OnPaint"
                                    MouseDown="OnMouseDown" MouseMove="OnMouseMove" 
                                    MouseUp="OnMouseUp" MouseWheel="OnMouseWheel"
                                    MouseLeave="OnMouseLeave"
                                    MouseRightButtonDown="OnMouseRightButtonDown"
                                    KeyDown="OnKeyDown"
                                    KeyUp="OnKeyUp"
                                    Focusable="True"/>
                    <skia:SKElement x:Name="RulerOverlayCanvas"
                                    Panel.ZIndex="1"
                                    PaintSurface="OnRulerOverlayPaint"
                                    IsHitTestVisible="False"/>
                    <Canvas x:Name="InlineTextInputLayer"
                            Panel.ZIndex="2">
                        <TextBox x:Name="InlineTextInputSink"
                                 Width="1"
                                 Height="1"
                                 Opacity="0.01"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="Transparent"
                                 CaretBrush="Transparent"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled"
                                 TextChanged="InlineTextInputSink_TextChanged"
                                 PreviewKeyDown="InlineTextInputSink_PreviewKeyDown"
                                 LostKeyboardFocus="InlineTextInputSink_LostKeyboardFocus"/>
                    </Canvas>
                    <Popup x:Name="ContextMenuPopup"
                        AllowsTransparency="True"
                        Opened="ContextMenuPopup_Opened"
                        PopupAnimation="Fade"
                        Placement="MousePoint"
                        StaysOpen="True">
                        <Menu x:Name="ContextMenu"
                            ItemsSource="{Binding MenuItems}"
                            Background="{StaticResource MenuBackgroundBrush}"
                            BorderBrush="#4A4F5E"
                            BorderThickness="1"
                            Effect="{StaticResource MenuShadow}">
                            <!-- 强制垂直排列所有菜单项 -->
                            <Menu.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </Menu.ItemsPanel>

                            <!-- 定义 MenuItem 容器的样式，绑定 ViewModel 属性 -->
                            <Menu.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource CanvasMenuItemStyle}">
                                    <!-- 绑定 Header（支持下划线快捷键） -->
                                    <Setter Property="Header" Value="{Binding Header}" />
                                    <!-- 绑定快捷键文本 -->
                                    <Setter Property="InputGestureText" Value="{Binding InputGestureText}" />
                                    <!-- 绑定命令和参数 -->
                                    <Setter Property="Command" Value="{Binding Command}" />
                                    <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
                                    <!-- 绑定子菜单项集合 -->
                                    <Setter Property="ItemsSource" Value="{Binding Children}" />
                                    <!-- 关键：让子菜单项也使用相同的样式 -->
                                    <Setter Property="ItemContainerStyle">
                                        <Setter.Value>
                                            <Style TargetType="MenuItem">
                                                <!-- 这里需要重复定义，或者通过 BasedOn 引用 -->
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="InputGestureText" Value="{Binding InputGestureText}" />
                                                <Setter Property="Command" Value="{Binding Command}" />
                                                <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
                                                <Setter Property="ItemsSource" Value="{Binding Children}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="MenuItem">
                                                                    <Separator Margin="8,4"
                                                                        Background="{StaticResource MenuSeparatorBrush}"
                                                                        Height="1" />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Setter.Value>
                                    </Setter>


                                    <!-- 处理分隔符：若 IsSeparator 为 true，则替换为 Separator 控件 -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Separator Margin="8,4"
                                                            Background="{StaticResource MenuSeparatorBrush}"
                                                            Height="1" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Menu.ItemContainerStyle>
                        </Menu>
                    </Popup>
                </Grid>

            </Border>

            <Border Grid.Row="1" Background="#F7F7F7" 
                        BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" Height="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" x:Name="CanvasTabsScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  SizeChanged="CanvasTabsScrollViewer_SizeChanged">
                        <StackPanel x:Name="TabPanel" Orientation="Horizontal" Margin="0">
                            <ItemsControl x:Name="CanvasTabs" ItemsSource="{Binding CanvasList}" Margin="0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TabBorder"
                                                    BorderBrush="#FF999999" BorderThickness="1" 
                                                    Margin="0,0,1,0" Padding="8,0"
                                                    Width="160" Height="28"
                                                    MouseLeftButtonDown="CanvasTab_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#A4AAAC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#1A5EB4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel.Resources>
                                                    <Style x:Key="ActiveTabTextStyle" TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="Foreground" Value="#333333"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Resources>
                                                <Grid Width="130" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CanvasNameTextBlock"
                                                               Text="{Binding Name}"
                                                               Tag="{Binding Id}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontWeight="{Binding IsActive, Converter={StaticResource BoolToFontWeightConverter}}"
                                                               PreviewMouseLeftButtonDown="CanvasName_PreviewMouseLeftButtonDown"
                                                               MouseLeftButtonDown="CanvasName_MouseLeftButtonDown"
                                                               Style="{StaticResource ActiveTabTextStyle}"/>
                                                    <TextBox x:Name="CanvasNameEditor"
                                                             Visibility="Collapsed"
                                                             Text="{Binding Name, Mode=OneWay}"
                                                             VerticalAlignment="Center"
                                                             Height="20"
                                                             Padding="2,0"
                                                             MaxLength="31"
                                                             PreviewKeyDown="CanvasNameEditor_PreviewKeyDown"
                                                             LostKeyboardFocus="CanvasNameEditor_LostKeyboardFocus"
                                                             PreviewTextInput="CanvasNameEditor_PreviewTextInput"
                                                             DataObject.Pasting="CanvasNameEditor_Pasting"/>
                                                </Grid>
                                                <Button Margin="-6,0,0,0" Click="CloseCanvas_Click" 
                                                        Tag="{Binding}" 
                                                        BorderThickness="0" Padding="2"
                                                        VerticalAlignment="Center"> 
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="X" FontSize="12" Style="{StaticResource ActiveTabTextStyle}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Width="36">
                                <!--<Button x:Name="AddButtonInScroll" Content="+" Width="26" Height="22" Margin="5,0" 
                                        Command="{Binding NewCanvasCommand}" 
                                        FontWeight="Bold" FontSize="14" 
                                        Padding="0" VerticalContentAlignment="Center"/>-->
                                <Button x:Name="AddButtonInScroll"
                                        Style="{StaticResource CanvasTabIconButtonStyle}"
                                        Width="26" Height="22"
                                        Margin="5,0"
                                        Command="{Binding NewCanvasCommand}">
                                    <Image Width="16"
                                           Height="16">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Source"
                                                        Value="/DrSoft.Drawing.Controls;component/Resources/image/Canvas/add.png"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsPressed}"
                                                                 Value="True">
                                                        <Setter Property="Source"
                                                                Value="/DrSoft.Drawing.Controls;component/Resources/image/Canvas/add_press.png"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="AddButtonFixed"
                            Grid.Column="1"
                            Style="{StaticResource CanvasTabIconButtonStyle}"
                            Width="26"
                            Height="22"
                            Margin="5,0"
                            Command="{Binding NewCanvasCommand}"
                            Visibility="Collapsed">
                        <Image Width="16"
                               Height="16">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source"
                                            Value="/DrSoft.Drawing.Controls;component/Resources/image/Canvas/add.png"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsPressed}"
                                                     Value="True">
                                            <Setter Property="Source"
                                                    Value="/DrSoft.Drawing.Controls;component/Resources/image/Canvas/add_press.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource CanvasTabIconButtonStyle}"
                            Width="16"
                            Height="23"
                            Margin="0,0,2,0"
                            Background="#CBCBCB"
                            Click="ScrollCanvasLeft_Click">
                        <Image Width="16"
                               Height="23">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source"
                                            Value="/DrSoft.Drawing.Controls;component/Resources/image/Canvas/left.png"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsPressed}"
                                                     Value="True">
                                            <Setter Property="Source"
                                                    Value="/DrSoft.Drawing.Controls;component/Resources/image/Canvas/left_press.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                    <Button Grid.Column="3"
                            Style="{StaticResource CanvasTabIconButtonStyle}"
                            Width="16"
                            Height="23"
                            Margin="0,0,5,0"
                            Background="#CBCBCB"
                            Click="ScrollCanvasRight_Click">
                        <Image Width="16"
                               Height="23">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source"
                                            Value="/DrSoft.Drawing.Controls;component/Resources/image/Canvas/right.png"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsPressed}"
                                                     Value="True">
                                            <Setter Property="Source"
                                                    Value="/DrSoft.Drawing.Controls;component/Resources/image/Canvas/right_press.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Button>
                </Grid>
            </Border>

        </Grid>

        <!-- 右侧属性面板 -->
        <!--
        <Border Grid.Column="2" Background="#FFF8F8F8" BorderBrush="#FFCCCCCC" BorderThickness="1,0,0,0">
            <controls:PropertyPanelView x:Name="PropertyPanel"/>
        </Border>-->
    </Grid>
</UserControl>
