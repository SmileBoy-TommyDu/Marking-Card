<UserControl x:Class="DrSoft.Drawing.Controls.Views.LayerViewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrSoft.Drawing.Controls.ViewModels"
             xmlns:conv="clr-namespace:DrSoft.Drawing.Controls.Converters"      
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d"
             MinWidth="200"
             MinHeight="200"
              d:DesignHeight="548" d:DesignWidth="180"
             >

    <UserControl.Resources>

        <Style x:Key="AddIconButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Image x:Name="icon"
                        Width="14"
                        Height="14"
                        Source="/DrSoft.Drawing.Controls;component/Resources/layer/add.png"
                        Stretch="Fill"
                        VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <!-- 按下时切换图片 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="icon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/adds.png"/>
                            </Trigger>
                            <!-- 松开后自动恢复为 center.png（因为触发器恢复原值） -->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelIconButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Image x:Name="icon"
                     Width="14"
                     Height="14"
                     Source="/DrSoft.Drawing.Controls;component/Resources/layer/del.png"
                     Stretch="Fill"
                     VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <!-- 按下时切换图片 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="icon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/dels.png"/>
                            </Trigger>
                            <!-- 松开后自动恢复为 center.png（因为触发器恢复原值） -->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="CopyIconButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Image x:Name="icon"
                     Width="14"
                     Height="14"
                     Source="/DrSoft.Drawing.Controls;component/Resources/layer/copy.png"
                     Stretch="Fill"
                     VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <!-- 按下时切换图片 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="icon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/copys.png"/>
                            </Trigger>
                            <!-- 松开后自动恢复为 center.png（因为触发器恢复原值） -->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Image x:Name="icon"
                     Width="14"
                     Height="14"
                     Source="/DrSoft.Drawing.Controls;component/Resources/layer/show.png"
                     Stretch="Fill"
                     VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter TargetName="icon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/noshow.png"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
              
            </Setter>
        </Style>

        <Style x:Key="AllEyeButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Image x:Name="icon"
                Width="14"
                Height="14"
                Source="/DrSoft.Drawing.Controls;component/Resources/layer/show.png"
                Stretch="Fill"
                VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAllVisible}" Value="False">
                                <Setter TargetName="icon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/noshow.png"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>

            </Setter>
        </Style>

        <Style x:Key="LockButtonStyle" TargetType="Button">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Image x:Name="icon"
                  Width="16"
                  Height="16"
                  Source="/DrSoft.Drawing.Controls;component/Resources/layer/lock.png"
                  Stretch="Fill"
                  VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                <Setter TargetName="icon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/unlock.png"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SingleButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Image x:Name="icon"
           Width="16"
           Height="16"
           Source="/DrSoft.Drawing.Controls;component/Resources/layer/71-0.png"
           Stretch="Fill"
           VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSingle}" Value="False">
                                <Setter TargetName="icon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/71-1.png"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ══ 颜色常量 ══════════════════════════════════════════ -->
        <SolidColorBrush x:Key="PanelBg"      Color="#F5F5F5"/>
        <SolidColorBrush x:Key="HeaderBg"     Color="#F5F5F5"/>
        <SolidColorBrush x:Key="RowHoverBg"   Color="#EDEEEF"/>
        <SolidColorBrush x:Key="RowSelectedBg" Color="#DDE7F4"/>
        <SolidColorBrush x:Key="IconFg"       Color="#444444"/>
        <SolidColorBrush x:Key="TextFg"       Color="#2A2C2B"/>
        <SolidColorBrush x:Key="MutedFg"      Color="#858E90"/>
        <SolidColorBrush x:Key="LockIcon"     Color="#888888"/>
        <SolidColorBrush x:Key="HiddenIcon"   Color="#AAAAAA"/>

        <!-- ══ 眼睛按钮（可见切换）═══════════════════════════════ -->
        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Width"      Value="18"/>
            <Setter Property="Height"     Value="18"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D8E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    

        <conv:StringToBrushConverter        x:Key="StringToBrush"/>
        <conv:BoolToEyeIconConverter        x:Key="BoolToEyeIcon"/>
        <conv:BoolToLockIconConverter       x:Key="BoolToLockIcon"/>
        <conv:BoolToSelectionBrushConverter x:Key="BoolToSelectionBrush"/>
        <conv:BoolToVisibilityConverter     x:Key="BoolToVisibility"/>
        <conv:BoolToExpandIconConverter     x:Key="BoolToExpandIcon"/>
        <conv:StringToColorConverter        x:Key="StringToColorConverter"/>

        <!-- ══ Hatch 填满节点行模板 ═════════════════════════════════ -->
        <DataTemplate DataType="{x:Type vm:NodeHatchViewModel}">
            <Border x:Name="RowBorder" Height="22" 
            Cursor="Hand" HorizontalAlignment="Stretch"
            MouseLeftButtonDown="UnifiedRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Image Grid.Column="1"
                   Width="14" Height="14"
                   Source="/DrSoft.Drawing.Controls;component/Resources/layer/hatch.png"    
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                       Text="{Binding ShapeTypeName}"
                               
                               
                       Foreground="{StaticResource TextFg}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="3"
                       Text="("
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="4"
                       Text="{Binding Name}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="5"
                       Text=")"
                               
                               
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" 
                            Value="{StaticResource RowSelectedBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="RowBorder" Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowBorder" Property="Background" 
                            Value="{StaticResource RowHoverBg}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ══ 图形节点行模板 ════════════════════════════════════════ -->
        <HierarchicalDataTemplate DataType="{x:Type vm:NodeShapeViewModel}"
                          ItemsSource="{Binding Children}">
            <Border x:Name="RowBorder" Height="22" 
            Cursor="Hand" HorizontalAlignment="Stretch"
            MouseLeftButtonDown="UnifiedRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="1" Source="{Binding IconPath}"
                   Width="16" Height="16"  
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                       Text="{Binding ShapeTypeName}"
                       Foreground="{StaticResource TextFg}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="3"
                       Text="("
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="4"
                       Text="{Binding Name}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="5"
                       Text=")"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background"
                            Value="{StaticResource RowSelectedBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="RowBorder" Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowBorder" Property="Background"
                            Value="{StaticResource RowHoverBg}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- ══ 群组节点行模板 ════════════════════════════════════════ -->
        <HierarchicalDataTemplate DataType="{x:Type vm:NodeGroupViewModel}"
                          ItemsSource="{Binding Children}">
            <Border x:Name="GroupBorder" Height="22" 
            HorizontalAlignment="Stretch"
            Cursor="Hand"
            MouseLeftButtonDown="UnifiedRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                    </Grid.ColumnDefinitions>

                    <!-- 展开/收起按钮 -->
                    <ToggleButton Margin="0,0,0,0" Grid.Column="1"
                          x:Name="Expander"
                          Width="14" Height="14"
                          ClickMode="Press"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}">
                                                <Image x:Name="ExpanderIcon" Source="/DrSoft.Drawing.Controls;component/Resources/layer/group-1.png"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ExpanderIcon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/fileopen.png"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    
                    
                    <!--<Image Grid.Column="1"
                   Width="14" Height="14"
                   Source="/DrSoft.Drawing.Controls;component/Resources/layer/group-1.png"    
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />-->

                    <TextBlock Grid.Column="2"
                       Text="群组"
                       Foreground="{StaticResource TextFg}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="3"
                       Text="("
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="4"
                       Text="{Binding Name}"
                       Foreground="{StaticResource TextFg}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="5"
                       Text=")"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="GroupBorder" Property="Background"
                            Value="{StaticResource RowSelectedBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="GroupBorder" Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="GroupBorder" Property="Background"
                            Value="{StaticResource RowHoverBg}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- ══ 组合节点行模板 ════════════════════════════════════════ -->
        <DataTemplate DataType="{x:Type vm:NodeCombinationViewModel}">
            <Border x:Name="RowBorder" Height="22" 
            Cursor="Hand" HorizontalAlignment="Stretch"
            MouseLeftButtonDown="UnifiedRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="1"
                   Width="14" Height="14"
                   Source="/DrSoft.Drawing.Controls;component/Resources/layer/shape2.png"    
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                       Text="{Binding ShapeTypeName}"
                       Foreground="{StaticResource TextFg}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="3"
                       Text="("
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="4"
                       Text="{Binding Name}"
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                    <TextBlock Grid.Column="5"
                       Text=")"
                               
                               
                       VerticalAlignment="Center"
                       Margin="3,0,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RowBorder" Property="Background"
                            Value="{StaticResource RowSelectedBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="RowBorder" Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowBorder" Property="Background"
                            Value="{StaticResource RowHoverBg}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ══ 图层行完整模板 ════════════════════════════════════ -->
        <HierarchicalDataTemplate DataType="{x:Type vm:LayerViewModel}"
                  ItemsSource="{Binding Children}">
            <Border x:Name="LayerBorder" Height="26" HorizontalAlignment="Stretch"
    BorderThickness="0,1,0,1"
    BorderBrush="#CCCCCC"
    Cursor="Hand"
    MouseLeftButtonDown="UnifiedRow_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>

                    <!-- 眼睛按钮区域 -->
                    <Border x:Name="EyeBoard" 
            Grid.Column="0"
            BorderThickness="1,0" BorderBrush="#e2e2e2">
                        <Button Style="{StaticResource EyeButtonStyle}" ToolTip="切换可见"
                Command="{Binding DataContext.ToggleLayerVisibleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"/>
                    </Border>

                    <!-- 展开/收起按钮区域 -->
                    <Border x:Name="ExpanderBorder"
            Grid.Column="1"
            BorderThickness="0" BorderBrush="#e2e2e2">
                        
                        <ToggleButton x:Name="Expander"
                      Width="14" Height="14"
                      ClickMode="Press"
                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Image  x:Name="ExpanderIcon" Source="/DrSoft.Drawing.Controls;component/Resources/layer/9-0.png"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ExpanderIcon" Property="Source" Value="/DrSoft.Drawing.Controls;component/Resources/layer/9.png"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                    <!-- 名称 + 数量 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                VerticalAlignment="Center" Margin="3,0,0,0">
                        <TextBlock Text="{Binding Name}"
                   Foreground="{StaticResource TextFg}"/>
                        <TextBlock  Foreground="{StaticResource MutedFg}"
                   Margin="4,0,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="({0})">
                                    <Binding Path="ShapeCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <!-- 图层颜色块 -->
                    <Border Grid.Column="3"
            Width="22" Height="22"
            Cursor="Hand"
            VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding Color,  Converter={StaticResource StringToColorConverter}}"/>
                        </Border.Background>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding BorderClickCommand}"/>
                        </Border.InputBindings>
                    </Border>

                    <!-- 锁定按钮 -->
                    <Button Grid.Column="4" Style="{StaticResource LockButtonStyle}"
            Command="{Binding DataContext.ToggleLockCommand,
                RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}"
            ToolTip="切换锁定"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="LayerBorder" Property="Background"  
                            Value="{StaticResource RowSelectedBg}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="LayerBorder" Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LayerBorder" Property="Background"
                            Value="{StaticResource RowHoverBg}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </HierarchicalDataTemplate>



    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ══ 图层列表（虚拟化：仅渲染可视区域，滚动时回收容器）══ -->
        <TreeView Grid.Row="0" 
                  ItemsSource="{Binding LayerViewModels}"
                  x:Name="LayerTreeView"
                  BorderThickness="0"
                  Background="Transparent"
                  AllowDrop="True"
                  Focusable="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.CacheLength="10,10"
                  VirtualizingPanel.CacheLengthUnit="Item"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseMove="TreeView_PreviewMouseMove"
                  DragOver="TreeView_DragOver"
                  DragLeave="TreeView_DragLeave"
                  Drop="TreeView_Drop">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 内容区域 -->
                                    <Border x:Name="Bd"
                                                Grid.Row="0"  >
                                        <ContentPresenter x:Name="PART_Header"
                                                              ContentSource="Header"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>

                                    <!-- 子项容器 -->
                                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="22,0,0,0" />
                                
                                </Grid>
                                <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
         </TreeView>

        <!-- ══ 底部工具栏 ════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBg}"   BorderThickness="0,1,0,0" BorderBrush="#e2e2e2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderThickness="1" BorderBrush="#e2e2e2">
                    <Button HorizontalAlignment="Center"  VerticalAlignment="Center" Style="{StaticResource AllEyeButtonStyle}" ToolTip="全部可见"
                            Command="{Binding ToggleAllVisibleCommand}"/>
                </Border>
                <!-- bind layer count -->
                <TextBlock x:Name="LayerCountTextBlock" Grid.Column="1" Text="{Binding LayerCount, StringFormat='总数:{0}'}" Margin="4,7" Foreground="#858E90" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"  >
                    <Button Style="{StaticResource SingleButtonStyle}" Margin="3,0"  Command="{Binding SingleLayerCommand}"  ToolTip="只显示单一图层"/>
                    <Button Style="{StaticResource AddIconButtonStyle}"  Margin="3,0" Command="{Binding AddLayerCommand}"    ToolTip="新建图层"/>
                    <Button Style="{StaticResource DelIconButtonStyle}" Margin="3,0"  Command="{Binding RemoveLayerCommand}" ToolTip="删除图层"/>
                    <Button Style="{StaticResource CopyIconButtonStyle}" Margin="3,0"  Command="{Binding CopyLayerCommand}"  ToolTip="复制图层"/>
                    <Button Visibility="Collapsed" Content="↑" Width="22" Height="22" FontSize="13"
              Style="{StaticResource EyeButton}"
              Command="{Binding MoveUpCommand}"
              ToolTip="上移"/>
                    <Button Visibility="Collapsed" Content="↓" Width="22" Height="22" FontSize="13"
              Style="{StaticResource EyeButton}"
              Command="{Binding MoveDownCommand}"
              ToolTip="下移"/>
                </StackPanel>
            </Grid>
          
        </Border>
    </Grid>

</UserControl>
